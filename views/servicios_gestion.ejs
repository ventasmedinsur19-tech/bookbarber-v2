<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Servicios | BookBarber</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>

    body {
      background-color: #0a0a0a;
      color: #e5e5e5;
    }

    * {
      -webkit-tap-highlight-color: transparent;
    }

  </style>

</head>


<body class="min-h-screen font-sans">

  <main
    class="max-w-6xl mx-auto px-4 py-6 md:px-8 md:py-10"
  >

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7"
    >

      <div>

        <div class="flex items-center gap-2">

          <h1
            class="text-2xl md:text-3xl font-black text-white"
          >
            Servicios
          </h1>


          <button
            type="button"
            onclick="toggleInfoModal()"
            class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-orange-500 font-black text-sm flex items-center justify-center transition"
          >
            i
          </button>

        </div>


        <p
          class="text-xs md:text-sm text-zinc-500 mt-1"
        >
          Configurá los servicios disponibles en cada sucursal.
        </p>

      </div>


      <a
        href="/dashboard"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-sm text-zinc-300 font-bold rounded-xl transition border border-zinc-800"
      >

        <i class="fas fa-arrow-left"></i>

        Volver al Dashboard

      </a>

    </header>


    <!-- =====================================================
         INFORMACIÓN
    ====================================================== -->

    <section
      id="infoModal"
      class="hidden mb-6 bg-zinc-900 border border-orange-500/30 rounded-2xl p-5 shadow-xl"
    >

      <div
        class="flex justify-between items-start gap-4"
      >

        <div>

          <h3
            class="text-orange-500 font-black mb-2"
          >

            <i class="fas fa-circle-info mr-1"></i>

            ¿Qué podés hacer acá?

          </h3>


          <p
            class="text-sm text-zinc-300 leading-relaxed"
          >

            Creá los servicios que ofrece cada sucursal,
            indicando su nombre, precio y duración.

            La duración será utilizada posteriormente por
            BookBarber para organizar correctamente los
            horarios y turnos disponibles.

          </p>

        </div>


        <button
          type="button"
          onclick="toggleInfoModal()"
          class="text-zinc-500 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>

    </section>


    <!-- =====================================================
         CONTENIDO PRINCIPAL
    ====================================================== -->

    <div
      class="grid grid-cols-1 lg:grid-cols-[390px_1fr] gap-6"
    >

      <!-- =================================================
           NUEVO SERVICIO
      ================================================== -->

      <section
        class="bg-zinc-900 border border-zinc-800 p-5 md:p-6 rounded-2xl shadow-lg h-fit"
      >

        <div
          class="flex items-center gap-3 mb-5"
        >

          <div
            class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500"
          >

            <i class="fas fa-scissors"></i>

          </div>


          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Nuevo Servicio
            </h2>

            <p class="text-xs text-zinc-500">
              Agregá un servicio a tu catálogo.
            </p>

          </div>

        </div>


        <% if (!sucursales || sucursales.length === 0) { %>

          <div
            class="bg-orange-500/10 border border-orange-500/20 rounded-xl p-4"
          >

            <p
              class="text-sm text-orange-400 font-bold"
            >
              Primero necesitás crear una sucursal.
            </p>


            <a
              href="/sucursales"
              class="inline-block mt-3 text-xs font-black text-white underline"
            >
              Ir a Sucursales
            </a>

          </div>

        <% } else { %>


          <form
            action="/servicios/guardar"
            method="POST"
            class="space-y-4"
          >

            <!-- SUCURSAL -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Sucursal
              </label>


              <select
                name="sucursal_id"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
              >

                <% sucursales.forEach(s => { %>

                  <option value="<%= s.id %>">
                    <%= s.nombre %>
                  </option>

                <% }) %>

              </select>

            </div>


            <!-- NOMBRE -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Nombre del Servicio
              </label>


              <input
                type="text"
                name="nombre"
                placeholder="Ej: Corte Clásico"
                maxlength="100"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
              >

            </div>


            <!-- PRECIO -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Precio
              </label>


              <div class="relative">

                <span
                  class="absolute left-3 top-1/2 -translate-y-1/2 text-orange-500 font-black"
                >
                  $
                </span>


                <input
                  type="number"
                  name="precio"
                  placeholder="10000"
                  min="0"
                  step="1"
                  required
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-8 pr-3 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
                >

              </div>


              <p
                class="text-[10px] text-zinc-600 mt-1.5"
              >
                Ingresá el precio en pesos argentinos.
              </p>

            </div>


            <!-- DURACIÓN -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Duración del Servicio
              </label>


              <select
                name="duracion_minutos"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
              >

                <option value="15">
                  15 minutos
                </option>

                <option value="20">
                  20 minutos
                </option>

                <option value="30" selected>
                  30 minutos
                </option>

                <option value="45">
                  45 minutos
                </option>

                <option value="60">
                  1 hora
                </option>

                <option value="75">
                  1 hora 15 minutos
                </option>

                <option value="90">
                  1 hora 30 minutos
                </option>

                <option value="120">
                  2 horas
                </option>

              </select>


              <p
                class="text-[10px] text-zinc-600 mt-1.5"
              >
                BookBarber utilizará esta duración para
                calcular la disponibilidad.
              </p>

            </div>


            <!-- BOTÓN -->

            <button
              type="submit"
              class="w-full bg-orange-600 hover:bg-orange-500 text-white font-black py-3 rounded-xl transition text-sm shadow-md shadow-orange-900/20"
            >

              <i class="fas fa-plus mr-2"></i>

              Agregar Servicio

            </button>

          </form>

        <% } %>

      </section>


      <!-- =================================================
           LISTADO DE SERVICIOS
      ================================================== -->

      <section>

        <div
          class="flex items-center justify-between gap-4 mb-4"
        >

          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Tus Servicios
            </h2>


            <p
              class="text-xs text-zinc-500 mt-1"
            >
              <%= servicios.length %>
              servicio(s) registrado(s)
            </p>

          </div>

        </div>


        <% if (!servicios || servicios.length === 0) { %>

          <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl p-10 text-center"
          >

            <div
              class="w-16 h-16 mx-auto rounded-full bg-zinc-800 flex items-center justify-center mb-4"
            >

              <i
                class="fas fa-scissors text-2xl text-zinc-600"
              ></i>

            </div>


            <p
              class="text-zinc-500 text-sm"
            >
              No tenés servicios registrados todavía.
            </p>

          </div>

        <% } %>


        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-4"
        >

          <% servicios.forEach(servicio => { %>

            <article
              class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg"
            >

              <!-- CABECERA -->

              <div
                class="flex items-start justify-between gap-3"
              >

                <div class="min-w-0">

                  <h3
                    class="font-black text-white text-lg truncate"
                  >
                    <%= servicio.nombre %>
                  </h3>


                  <span
                    class="inline-flex items-center mt-2 text-[9px] font-black tracking-wide uppercase text-orange-400 bg-orange-500/10 px-2 py-1 rounded-lg border border-orange-500/20"
                  >

                    <i
                      class="fas fa-store mr-1"
                    ></i>

                    <%= servicio.sucursal_nombre %>

                  </span>

                </div>


                <div
                  class="w-11 h-11 shrink-0 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500"
                >

                  <i class="fas fa-scissors"></i>

                </div>

              </div>


              <!-- INFORMACIÓN -->

              <div
                class="grid grid-cols-2 gap-2 my-4"
              >

                <!-- PRECIO -->

                <div
                  class="bg-black/40 border border-zinc-800 rounded-xl p-3"
                >

                  <p
                    class="text-[9px] uppercase tracking-widest font-bold text-zinc-600 mb-1"
                  >
                    Precio
                  </p>


                  <p
                    class="text-base font-black text-green-400"
                  >
                    $<%= Number(servicio.precio || 0).toLocaleString('es-AR') %>
                  </p>

                </div>


                <!-- DURACIÓN -->

                <div
                  class="bg-black/40 border border-zinc-800 rounded-xl p-3"
                >

                  <p
                    class="text-[9px] uppercase tracking-widest font-bold text-zinc-600 mb-1"
                  >
                    Duración
                  </p>


                  <p
                    class="text-base font-black text-white"
                  >

                    <i
                      class="fas fa-clock text-orange-500 mr-1"
                    ></i>

                    <%= servicio.duracion_minutos || 30 %> min

                  </p>

                </div>

              </div>


              <!-- ACCIONES -->

              <div
                class="grid grid-cols-2 gap-2"
              >

                <button
                  type="button"

                  onclick="openEditModal(this)"

                  data-id="<%= servicio.id %>"

                  data-nombre="<%= encodeURIComponent(servicio.nombre || '') %>"

                  data-precio="<%= servicio.precio || 0 %>"

                  data-duracion="<%= servicio.duracion_minutos || 30 %>"

                  data-sucursal="<%= servicio.sucursal_id %>"

                  class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs py-2.5 rounded-xl font-bold transition"
                >

                  <i
                    class="fas fa-pen mr-1"
                  ></i>

                  Editar

                </button>


                <form
                  action="/servicios/eliminar/<%= servicio.id %>"
                  method="POST"
                  onsubmit="return confirm('¿Seguro que querés eliminar este servicio?');"
                >

                  <button
                    type="submit"
                    class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs py-2.5 rounded-xl font-bold transition"
                  >

                    <i
                      class="fas fa-trash mr-1"
                    ></i>

                    Eliminar

                  </button>

                </form>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    </div>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer
      class="mt-12 pt-6 border-t border-zinc-900 text-center text-[10px] text-zinc-600"
    >

      © <%= new Date().getFullYear() %>
      MedinSur Dev · BookBarber

    </footer>

  </main>


  <!-- =====================================================
       MODAL EDITAR
  ====================================================== -->

  <div
    id="editModal"
    class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto"
  >

    <div
      class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 md:p-6 w-full max-w-md shadow-2xl my-6"
    >

      <!-- CABECERA MODAL -->

      <div
        class="flex items-center justify-between mb-5"
      >

        <div>

          <h3
            class="text-lg font-black text-white"
          >
            Editar Servicio
          </h3>


          <p
            class="text-xs text-zinc-500 mt-1"
          >
            Modificá los datos del servicio.
          </p>

        </div>


        <button
          type="button"
          onclick="closeEditModal()"
          class="w-9 h-9 rounded-xl bg-zinc-800 text-zinc-400 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>


      <!-- FORMULARIO -->

      <form
        id="editForm"
        method="POST"
        class="space-y-4"
      >

        <!-- SUCURSAL -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Sucursal
          </label>


          <select
            id="editSucursal"
            name="sucursal_id"
            disabled
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-zinc-500 text-sm cursor-not-allowed"
          >

            <% sucursales.forEach(s => { %>

              <option value="<%= s.id %>">
                <%= s.nombre %>
              </option>

            <% }) %>

          </select>


          <p
            class="text-[10px] text-zinc-600 mt-1.5"
          >
            La sucursal del servicio no se modifica desde esta edición.
          </p>

        </div>


        <!-- NOMBRE -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Nombre del Servicio
          </label>


          <input
            type="text"
            id="editNombre"
            name="nombre"
            maxlength="100"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

        </div>


        <!-- PRECIO -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Precio
          </label>


          <div class="relative">

            <span
              class="absolute left-3 top-1/2 -translate-y-1/2 text-orange-500 font-black"
            >
              $
            </span>


            <input
              type="number"
              id="editPrecio"
              name="precio"
              min="0"
              step="1"
              required
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-8 pr-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
            >

          </div>

        </div>


        <!-- DURACIÓN -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Duración
          </label>


          <select
            id="editDuracion"
            name="duracion_minutos"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

            <option value="15">
              15 minutos
            </option>

            <option value="20">
              20 minutos
            </option>

            <option value="30">
              30 minutos
            </option>

            <option value="45">
              45 minutos
            </option>

            <option value="60">
              1 hora
            </option>

            <option value="75">
              1 hora 15 minutos
            </option>

            <option value="90">
              1 hora 30 minutos
            </option>

            <option value="120">
              2 horas
            </option>

          </select>

        </div>


        <!-- BOTONES -->

        <div
          class="grid grid-cols-2 gap-2 pt-2"
        >

          <button
            type="button"
            onclick="closeEditModal()"
            class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 py-3 rounded-xl text-sm font-bold"
          >
            Cancelar
          </button>


          <button
            type="submit"
            class="bg-orange-600 hover:bg-orange-500 text-white py-3 rounded-xl text-sm font-black"
          >
            Actualizar
          </button>

        </div>

      </form>

    </div>

  </div>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    function toggleInfoModal() {

      document
        .getElementById('infoModal')
        .classList.toggle('hidden');

    }


    function openEditModal(button) {

      const id =
        button.dataset.id;


      const nombre =
        decodeURIComponent(
          button.dataset.nombre || ''
        );


      const precio =
        button.dataset.precio || '0';


      const duracion =
        button.dataset.duracion || '30';


      const sucursal =
        button.dataset.sucursal;


      document
        .getElementById('editForm')
        .action =
          `/servicios/editar/${id}`;


      document
        .getElementById('editNombre')
        .value =
          nombre;


      document
        .getElementById('editPrecio')
        .value =
          precio;


      document
        .getElementById('editDuracion')
        .value =
          duracion;


      document
        .getElementById('editSucursal')
        .value =
          sucursal;


      document
        .getElementById('editModal')
        .classList.remove('hidden');


      document.body.style.overflow =
        'hidden';

    }


    function closeEditModal() {

      document
        .getElementById('editModal')
        .classList.add('hidden');


      document.body.style.overflow =
        '';

    }


    document.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Escape'
        ) {

          closeEditModal();

        }

      }
    );

  </script>

</body>

</html>
