<!DOCTYPE html>
<html lang="es">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Sucursales | BookBarber</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>

    body {
      background-color: #0a0a0a;
      color: #e5e5e5;
    }

    * {
      -webkit-tap-highlight-color: transparent;
    }

    input[type="file"] {
      display: none;
    }

  </style>

</head>

<body class="min-h-screen font-sans">

  <main
    class="max-w-6xl mx-auto px-4 py-6 md:px-8 md:py-10"
  >

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7"
    >

      <div>

        <div class="flex items-center gap-2">

          <h1
            class="text-2xl md:text-3xl font-black text-white"
          >
            Sucursales
          </h1>


          <button
            type="button"
            onclick="toggleInfoModal()"
            class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-orange-500 font-black text-sm flex items-center justify-center transition"
          >
            i
          </button>

        </div>


        <p
          class="text-xs md:text-sm text-zinc-500 mt-1"
        >
          Administrá las sedes de tu barbería.
        </p>

      </div>


      <a
        href="/dashboard"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-sm text-zinc-300 font-bold rounded-xl transition border border-zinc-800"
      >

        <i class="fas fa-arrow-left"></i>

        Volver al Dashboard

      </a>

    </header>


    <!-- =====================================================
         INFO
    ====================================================== -->

    <section
      id="infoModal"
      class="hidden mb-6 bg-zinc-900 border border-orange-500/30 rounded-2xl p-5 shadow-xl"
    >

      <div
        class="flex justify-between items-start gap-4"
      >

        <div>

          <h3
            class="text-orange-500 font-black mb-2"
          >

            <i
              class="fas fa-circle-info mr-1"
            ></i>

            ¿Qué podés hacer acá?

          </h3>


          <p
            class="text-sm text-zinc-300 leading-relaxed"
          >

            Podés crear y administrar las diferentes
            sedes de tu barbería.

            Cada sucursal tiene su propio link público
            para recibir reservas.

            También podés subir el logo y una foto del
            local directamente desde la galería de tu
            celular.

          </p>

        </div>


        <button
          type="button"
          onclick="toggleInfoModal()"
          class="text-zinc-500 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>

    </section>


    <!-- =====================================================
         GRID
    ====================================================== -->

    <div
      class="grid grid-cols-1 lg:grid-cols-[390px_1fr] gap-6"
    >

      <!-- =================================================
           NUEVA SUCURSAL
      ================================================== -->

      <section
        class="bg-zinc-900 border border-zinc-800 p-5 md:p-6 rounded-2xl shadow-lg h-fit"
      >

        <div
          class="flex items-center gap-3 mb-5"
        >

          <div
            class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500"
          >

            <i class="fas fa-plus"></i>

          </div>


          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Nueva Sucursal
            </h2>

            <p class="text-xs text-zinc-500">
              Sumá una nueva sede.
            </p>

          </div>

        </div>


        <form
          action="/sucursales/guardar"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >

          <!-- NOMBRE -->

          <div>

            <label
              class="block text-xs font-bold text-zinc-400 mb-1.5"
            >
              Nombre
            </label>


            <input
              type="text"
              name="nombre"
              placeholder="Ej: La Urbana Centro"
              required
              maxlength="100"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
            >

          </div>


          <!-- DIRECCIÓN -->

          <div>

            <label
              class="block text-xs font-bold text-zinc-400 mb-1.5"
            >
              Dirección
            </label>


            <input
              type="text"
              name="direccion"
              placeholder="Ej: Miguel del Mármol 3730"
              required
              maxlength="255"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
            >

          </div>


          <!-- =================================================
               LOGO
          ================================================== -->

          <div>

            <p
              class="block text-xs font-bold text-zinc-400 mb-2"
            >
              Logo de la barbería
            </p>


            <label
              for="logo"
              class="cursor-pointer block bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl p-4 transition"
            >

              <div
                id="logoPlaceholder"
                class="text-center"
              >

                <div
                  class="w-12 h-12 mx-auto bg-zinc-900 rounded-xl flex items-center justify-center mb-2 text-orange-500"
                >
                  <i
                    class="fas fa-image text-xl"
                  ></i>
                </div>


                <p
                  class="text-sm font-bold text-white"
                >
                  Subir Logo
                </p>


                <p
                  class="text-[10px] text-zinc-500 mt-1"
                >
                  Elegí una foto desde tu galería
                </p>

              </div>


              <img
                id="logoPreview"
                class="hidden w-24 h-24 object-cover rounded-xl mx-auto border border-zinc-700"
              >

            </label>


            <input
              type="file"
              id="logo"
              name="logo"
              accept="image/jpeg,image/png,image/webp"
              onchange="previewImagen(this, 'logoPreview', 'logoPlaceholder')"
            >

          </div>


          <!-- =================================================
               FOTO LOCAL
          ================================================== -->

          <div>

            <p
              class="block text-xs font-bold text-zinc-400 mb-2"
            >
              Foto del Local
            </p>


            <label
              for="foto_local"
              class="cursor-pointer block bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl overflow-hidden transition"
            >

              <div
                id="fotoPlaceholder"
                class="text-center p-5"
              >

                <div
                  class="w-12 h-12 mx-auto bg-zinc-900 rounded-xl flex items-center justify-center mb-2 text-orange-500"
                >
                  <i
                    class="fas fa-camera text-xl"
                  ></i>
                </div>


                <p
                  class="text-sm font-bold text-white"
                >
                  Subir Foto del Local
                </p>


                <p
                  class="text-[10px] text-zinc-500 mt-1"
                >
                  Tocá para elegir desde tu galería
                </p>

              </div>


              <img
                id="fotoPreview"
                class="hidden w-full h-44 object-cover"
              >

            </label>


            <input
              type="file"
              id="foto_local"
              name="foto_local"
              accept="image/jpeg,image/png,image/webp"
              onchange="previewImagen(this, 'fotoPreview', 'fotoPlaceholder')"
            >

          </div>


          <div
            class="bg-blue-500/5 border border-blue-500/10 rounded-xl p-3"
          >

            <p
              class="text-[10px] text-blue-400 leading-relaxed"
            >

              <i
                class="fas fa-wand-magic-sparkles mr-1"
              ></i>

              BookBarber optimizará automáticamente
              las imágenes para que ocupen menos espacio.

            </p>

          </div>


          <button
            type="submit"
            class="w-full bg-orange-600 hover:bg-orange-500 text-white font-black py-3 rounded-xl transition text-sm shadow-md shadow-orange-900/20"
          >

            <i
              class="fas fa-floppy-disk mr-2"
            ></i>

            Guardar Sucursal

          </button>

        </form>

      </section>


      <!-- =================================================
           LISTADO
      ================================================== -->

      <section>

        <div
          class="flex items-center justify-between gap-4 mb-4"
        >

          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Tus Sucursales
            </h2>


            <p
              class="text-xs text-zinc-500 mt-1"
            >
              <%= sucursales.length %> registradas
            </p>

          </div>

        </div>


        <% if (!sucursales || sucursales.length === 0) { %>

          <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl p-10 text-center"
          >

            <i
              class="fas fa-store text-3xl text-zinc-700 mb-3"
            ></i>


            <p
              class="text-zinc-500 text-sm"
            >
              No tenés sucursales registradas.
            </p>

          </div>

        <% } %>


        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-4"
        >

          <% sucursales.forEach(suc => { %>

            <article
              class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-lg"
            >

              <!-- FOTO -->

              <div
                class="h-40 bg-zinc-950 relative overflow-hidden"
              >

                <% if (suc.foto_url) { %>

                  <img
                    src="<%= suc.foto_url %>?v=<%= Date.now() %>"
                    alt="<%= suc.nombre %>"
                    class="w-full h-full object-cover"
                  >

                <% } else { %>

                  <div
                    class="w-full h-full flex flex-col items-center justify-center text-zinc-700"
                  >

                    <i
                      class="fas fa-store text-4xl mb-2"
                    ></i>

                    <span
                      class="text-[9px] uppercase tracking-widest"
                    >
                      Sin foto del local
                    </span>

                  </div>

                <% } %>


                <!-- LOGO -->

                <% if (suc.logo_url) { %>

                  <div
                    class="absolute bottom-3 right-3 w-14 h-14 rounded-xl bg-zinc-900 border-2 border-zinc-900 overflow-hidden shadow-xl"
                  >

                    <img
                      src="<%= suc.logo_url %>?v=<%= Date.now() %>"
                      alt="Logo"
                      class="w-full h-full object-cover"
                    >

                  </div>

                <% } %>

              </div>


              <!-- DATOS -->

              <div class="p-5">

                <h3
                  class="font-black text-white text-lg"
                >
                  <%= suc.nombre %>
                </h3>


                <p
                  class="text-zinc-500 text-xs mt-1"
                >

                  <i
                    class="fas fa-location-dot text-orange-500 mr-1"
                  ></i>

                  <%= suc.direccion || 'Dirección no especificada' %>

                </p>


                <!-- LINK -->

                <div
                  class="bg-black/40 border border-zinc-800 rounded-xl p-3 my-4"
                >

                  <p
                    class="text-[9px] uppercase tracking-widest font-black text-zinc-600 mb-1"
                  >
                    Link de reservas
                  </p>


                  <p
                    class="text-xs font-mono text-orange-400 truncate"
                  >
                    bookbarber.online/b/<%= suc.id %>
                  </p>

                </div>


                <!-- BOTONES -->

                <div
                  class="grid grid-cols-2 gap-2"
                >

                  <button
                    type="button"
                    onclick="openEditModal(this)"
                    data-id="<%= suc.id %>"
                    data-nombre="<%= encodeURIComponent(suc.nombre || '') %>"
                    data-direccion="<%= encodeURIComponent(suc.direccion || '') %>"
                    data-logo="<%= encodeURIComponent(suc.logo_url || '') %>"
                    data-foto="<%= encodeURIComponent(suc.foto_url || '') %>"
                    class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs py-2.5 rounded-xl font-bold transition"
                  >

                    <i
                      class="fas fa-pen mr-1"
                    ></i>

                    Editar

                  </button>


                  <a
                    href="/b/<%= suc.id %>"
                    target="_blank"
                    class="bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/20 text-blue-400 text-xs py-2.5 rounded-xl font-bold transition text-center"
                  >

                    <i
                      class="fas fa-eye mr-1"
                    ></i>

                    Ver Link

                  </a>

                </div>


                <form
                  action="/sucursales/eliminar/<%= suc.id %>"
                  method="POST"
                  class="mt-2"
                  onsubmit="return confirm('¿Seguro que querés eliminar esta sucursal? También se eliminarán sus datos asociados.');"
                >

                  <button
                    type="submit"
                    class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs py-2.5 rounded-xl font-bold transition"
                  >

                    <i
                      class="fas fa-trash mr-1"
                    ></i>

                    Eliminar Sucursal

                  </button>

                </form>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    </div>


    <footer
      class="mt-12 pt-6 border-t border-zinc-900 text-center text-[10px] text-zinc-600"
    >

      © <%= new Date().getFullYear() %>
      MedinSur Dev · BookBarber

    </footer>

  </main>


  <!-- =====================================================
       MODAL EDITAR
  ====================================================== -->

  <div
    id="editModal"
    class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto"
  >

    <div
      class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 md:p-6 w-full max-w-md shadow-2xl my-6"
    >

      <div
        class="flex items-center justify-between mb-5"
      >

        <div>

          <h3
            class="text-lg font-black text-white"
          >
            Editar Sucursal
          </h3>


          <p
            class="text-xs text-zinc-500 mt-1"
          >
            También podés reemplazar sus imágenes.
          </p>

        </div>


        <button
          type="button"
          onclick="closeEditModal()"
          class="w-9 h-9 rounded-xl bg-zinc-800 text-zinc-400 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>


      <form
        id="editForm"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-4"
      >

        <!-- NOMBRE -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Nombre
          </label>


          <input
            type="text"
            id="editNombre"
            name="nombre"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

        </div>


        <!-- DIRECCIÓN -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Dirección
          </label>


          <input
            type="text"
            id="editDireccion"
            name="direccion"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

        </div>


        <!-- LOGO ACTUAL / NUEVO -->

        <div>

          <p
            class="block text-xs font-bold text-zinc-400 mb-2"
          >
            Logo
          </p>


          <div
            id="editLogoActualContenedor"
            class="hidden mb-3"
          >

            <p
              class="text-[10px] text-zinc-500 mb-2"
            >
              Logo actual
            </p>


            <img
              id="editLogoActual"
              class="w-20 h-20 object-cover rounded-xl border border-zinc-700"
            >

          </div>


          <label
            for="editLogo"
            class="cursor-pointer flex items-center justify-center gap-2 bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl p-4 transition"
          >

            <i
              class="fas fa-image text-orange-500"
            ></i>


            <span
              class="text-xs font-bold text-zinc-300"
            >
              Elegir nuevo logo
            </span>

          </label>


          <input
            type="file"
            id="editLogo"
            name="logo"
            accept="image/jpeg,image/png,image/webp"
          >

        </div>


        <!-- FOTO LOCAL -->

        <div>

          <p
            class="block text-xs font-bold text-zinc-400 mb-2"
          >
            Foto del Local
          </p>


          <div
            id="editFotoActualContenedor"
            class="hidden mb-3"
          >

            <p
              class="text-[10px] text-zinc-500 mb-2"
            >
              Foto actual
            </p>


            <img
              id="editFotoActual"
              class="w-full h-32 object-cover rounded-xl border border-zinc-700"
            >

          </div>


          <label
            for="editFotoLocal"
            class="cursor-pointer flex items-center justify-center gap-2 bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl p-4 transition"
          >

            <i
              class="fas fa-camera text-orange-500"
            ></i>


            <span
              class="text-xs font-bold text-zinc-300"
            >
              Elegir nueva foto
            </span>

          </label>


          <input
            type="file"
            id="editFotoLocal"
            name="foto_local"
            accept="image/jpeg,image/png,image/webp"
          >

        </div>


        <p
          class="text-[10px] text-zinc-500"
        >
          Si no elegís una nueva imagen, se conservará
          la actual.
        </p>


        <div
          class="grid grid-cols-2 gap-2 pt-2"
        >

          <button
            type="button"
            onclick="closeEditModal()"
            class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 py-3 rounded-xl text-sm font-bold"
          >
            Cancelar
          </button>


          <button
            type="submit"
            class="bg-orange-600 hover:bg-orange-500 text-white py-3 rounded-xl text-sm font-black"
          >
            Actualizar
          </button>

        </div>

      </form>

    </div>

  </div>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    function toggleInfoModal() {

      document
        .getElementById('infoModal')
        .classList.toggle('hidden');

    }


    function previewImagen(
      input,
      previewId,
      placeholderId
    ) {

      if (
        !input.files ||
        !input.files[0]
      ) {
        return;
      }


      const archivo =
        input.files[0];


      const preview =
        document.getElementById(
          previewId
        );


      const placeholder =
        document.getElementById(
          placeholderId
        );


      const reader =
        new FileReader();


      reader.onload =
        function(event) {

          preview.src =
            event.target.result;

          preview.classList.remove(
            'hidden'
          );

          placeholder.classList.add(
            'hidden'
          );

        };


      reader.readAsDataURL(
        archivo
      );

    }


    function openEditModal(button) {

      const id =
        button.dataset.id;


      const nombre =
        decodeURIComponent(
          button.dataset.nombre || ''
        );


      const direccion =
        decodeURIComponent(
          button.dataset.direccion || ''
        );


      const logo =
        decodeURIComponent(
          button.dataset.logo || ''
        );


      const foto =
        decodeURIComponent(
          button.dataset.foto || ''
        );


      document
        .getElementById('editForm')
        .action =
          `/sucursales/editar/${id}`;


      document
        .getElementById('editNombre')
        .value =
          nombre;


      document
        .getElementById('editDireccion')
        .value =
          direccion;


      const logoContenedor =
        document.getElementById(
          'editLogoActualContenedor'
        );


      const logoImagen =
        document.getElementById(
          'editLogoActual'
        );


      if (logo) {

        logoImagen.src =
          logo + '?v=' + Date.now();

        logoContenedor.classList.remove(
          'hidden'
        );

      } else {

        logoContenedor.classList.add(
          'hidden'
        );

      }


      const fotoContenedor =
        document.getElementById(
          'editFotoActualContenedor'
        );


      const fotoImagen =
        document.getElementById(
          'editFotoActual'
        );


      if (foto) {

        fotoImagen.src =
          foto + '?v=' + Date.now();

        fotoContenedor.classList.remove(
          'hidden'
        );

      } else {

        fotoContenedor.classList.add(
          'hidden'
        );

      }


      document
        .getElementById('editLogo')
        .value = '';


      document
        .getElementById('editFotoLocal')
        .value = '';


      document
        .getElementById('editModal')
        .classList.remove('hidden');


      document.body.style.overflow =
        'hidden';

    }


    function closeEditModal() {

      document
        .getElementById('editModal')
        .classList.add('hidden');


      document.body.style.overflow =
        '';

    }


    document.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Escape'
        ) {

          closeEditModal();

        }

      }
    );

  </script>

</body>
</html>
