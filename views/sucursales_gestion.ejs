<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Sucursales - BookBarber</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #121214; color: #e1e1e6; }
  </style>
</head>
<body class="p-4 min-h-screen font-sans">

  <div class="max-w-md mx-auto flex justify-between items-center mb-6">
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-bold text-white">Sucursales</h1>
      <button onclick="toggleInfoModal()" class="w-6 h-6 rounded-full bg-zinc-800 hover:bg-zinc-700 text-orange-500 font-bold text-sm flex items-center justify-center transition">
        i
      </button>
    </div>
    <a href="/dashboard" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-sm text-zinc-300 font-medium rounded-lg transition border border-zinc-700">
      ← Volver al Dashboard
    </a>
  </div>

  <div class="max-w-md mx-auto space-y-6">

    <div id="infoModal" class="hidden bg-zinc-900 border border-orange-500/30 rounded-xl p-4 shadow-xl">
      <div class="flex justify-between items-start mb-2">
        <h3 class="text-orange-500 font-bold flex items-center gap-2">💡 ¿Qué hacer en esta sección?</h3>
        <button onclick="toggleInfoModal()" class="text-zinc-400 hover:text-white font-bold">✕</button>
      </div>
      <p class="text-sm text-zinc-300 leading-relaxed">
        Acá podés dar de alta y administrar las diferentes sedes de tu barbería. Cada sucursal que crees tendrá su propio link único para que tus clientes puedan reservar turnos directamente. Podés editar el nombre, dirección y fotos en cualquier momento, o eliminarlas si ya no operan.
      </p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-lg">
      <h2 class="text-lg font-semibold text-orange-500 mb-4">Nueva Sucursal</h2>
      <form action="/sucursales/guardar" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Nombre</label>
          <input type="text" name="nombre" placeholder="Ej: La Urbana Central" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Dirección</label>
          <input type="text" name="direccion" placeholder="Ej: Miguel del Mármol 3730" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">URL del Logo (Opcional)</label>
          <input type="url" name="logo_url" placeholder="https://..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">URL Foto del Local (Opcional)</label>
          <input type="url" name="foto_url" placeholder="https://..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 text-sm">
        </div>
        <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white font-semibold py-2.5 rounded-lg transition text-sm shadow-md shadow-orange-900/20">
          Guardar Sucursal
        </button>
      </form>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-semibold text-zinc-400 tracking-wider uppercase mb-1">Tus Sucursales</h2>
      
      <% if (sucursales.length === 0) { %>
        <p class="text-zinc-500 text-sm italic text-center py-4">No tenés sucursales registradas todavía.</p>
      <% } %>

      <% sucursales.forEach(suc => { %>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 flex flex-col gap-3 shadow-md">
          <div class="flex items-center gap-3">
            <% if (suc.logo_url) { %>
              <img src="<%= suc.logo_url %>" class="w-12 h-12 rounded-lg object-cover bg-zinc-800 border border-zinc-700">
            <% } else { %>
              <div class="w-12 h-12 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-zinc-500 font-bold text-xl">🏬</div>
            <% } %>
            <div class="flex-1">
              <h3 class="font-bold text-white text-base"><%= suc.nombre %></h3>
              <p class="text-zinc-400 text-xs"><%= suc.direccion %></p>
              <span class="inline-block mt-1 text-[11px] font-mono text-orange-400 bg-orange-950/40 px-2 py-0.5 rounded border border-orange-900/30">
                /b/<%= suc.id %>
              </span>
            </div>
          </div>

          <div class="flex gap-2 border-t border-zinc-800/80 pt-3">
            <button onclick="openEditModal('<%= suc.id %>', '<%= suc.nombre %>', '<%= suc.direccion %>', '<%= suc.logo_url %>', '<%= suc.foto_url %>')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs py-2 rounded-lg font-medium transition text-center">
              ✏️ Editar
            </button>
            <form action="/sucursales/eliminar/<%= suc.id %>" method="POST" class="flex-1" onsubmit="return confirm('¿Seguro que querés eliminar esta sucursal? Se perderán los datos asociados.');">
              <button type="submit" class="w-full bg-red-950/40 hover:bg-red-900/40 text-red-400 border border-red-900/30 text-xs py-2 rounded-lg font-medium transition">
                🗑️ Eliminar
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div id="editModal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 w-full max-w-sm shadow-2xl">
      <h3 class="text-lg font-bold text-orange-500 mb-4">Editar Sucursal</h3>
      <form id="editForm" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Nombre</label>
          <input type="text" id="editNombre" name="nombre" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Dirección</label>
          <input type="text" id="editDireccion" name="direccion" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">URL del Logo</label>
          <input type="url" id="editLogoUrl" name="logo_url" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">URL Foto del Local</label>
          <input type="url" id="editFotoUrl" name="foto_url" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="closeEditModal()" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 py-2 rounded-lg text-sm font-medium transition">
            Cancelar
          </button>
          <button type="submit" class="flex-1 bg-orange-600 hover:bg-orange-500 text-white py-2 rounded-lg text-sm font-medium transition">
            Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleInfoModal() {
      const modal = document.getElementById('infoModal');
      modal.classList.toggle('hidden');
    }

    function openEditModal(id, nombre, direccion, logo, foto) {
      document.getElementById('editForm').action = `/sucursales/editar/${id}`;
      document.getElementById('editNombre').value = nombre;
      document.getElementById('editDireccion').value = direccion;
      document.getElementById('editLogoUrl').value = logo === 'null' ? '' : logo;
      document.getElementById('editFotoUrl').value = foto === 'null' ? '' : foto;
      document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
    }
  </script>
</body>
</html>
