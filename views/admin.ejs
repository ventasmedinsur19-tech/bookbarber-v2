<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel Master - MedinSur Dev</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { background-color: #09090b; color: #e4e4e7; }
  </style>
</head>
<body class="p-4 md:p-8 font-sans min-h-screen">

  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Header MedinSur Dev -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-zinc-800 pb-6">
      <div>
        <h1 class="text-3xl font-black text-white tracking-tight">Control Maestro</h1>
        <p class="text-orange-500 font-bold text-sm tracking-widest uppercase mt-1">BookBarber | by MedinSur Dev</p>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 px-4 py-2 rounded-lg flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
        <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest">Sistema En Línea</span>
      </div>
    </div>

    <% 
      // Cálculos globales para el panel
      let ingresosProyectados = 0;
      let totalSucursalesGlobal = 0;

      usuarios.forEach(u => {
        const base = 15000;
        const extras = Math.max(0, u.total_sucursales - 1) * 5000;
        ingresosProyectados += (base + extras);
        totalSucursalesGlobal += u.total_sucursales;
      });
    %>

    <!-- Métricas Generales (Kpis) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-lg border-l-4 border-l-blue-500">
        <p class="text-zinc-500 text-[10px] font-bold uppercase tracking-widest mb-1">Total Clientes</p>
        <p class="text-3xl font-black text-white"><%= usuarios.length %></p>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-lg border-l-4 border-l-purple-500">
        <p class="text-zinc-500 text-[10px] font-bold uppercase tracking-widest mb-1">Sucursales Activas</p>
        <p class="text-3xl font-black text-white"><%= totalSucursalesGlobal %></p>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-lg border-l-4 border-l-green-500">
        <p class="text-zinc-500 text-[10px] font-bold uppercase tracking-widest mb-1">Recaudación Mensual Proyectada</p>
        <p class="text-3xl font-black text-green-400">$<%= ingresosProyectados.toLocaleString('es-AR') %></p>
      </div>
    </div>

    <!-- Lista de Barberías Registradas -->
    <div>
      <h2 class="text-lg font-bold text-white mb-4">Base de Datos de Clientes</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% if (usuarios.length === 0) { %>
          <p class="text-zinc-500 text-sm">No hay clientes registrados todavía.</p>
        <% } %>

        <% usuarios.forEach(u => { 
            const fechaReg = new Date(u.fecha_registro);
            const diasTranscurridos = Math.floor((new Date() - fechaReg) / (1000 * 60 * 60 * 24));
            const diasRestantes = Math.max(0, 30 - diasTranscurridos);
            const cuotaMensual = 15000 + (Math.max(0, u.total_sucursales - 1) * 5000);
        %>
          <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-lg relative overflow-hidden">
            <!-- Barra de estado arriba -->
            <div class="absolute top-0 left-0 w-full h-1 <%= diasRestantes > 0 ? 'bg-green-500' : 'bg-red-500' %>"></div>
            
            <div class="flex justify-between items-start mb-4 mt-1">
              <div>
                <h3 class="font-bold text-white text-lg"><%= u.barberia_principal || 'Sin Nombre' %></h3>
                <p class="text-xs text-zinc-500 font-mono mt-1"><i class="fab fa-whatsapp text-green-500 mr-1"></i> <%= u.whatsapp %></p>
              </div>
              <span class="bg-zinc-950 border border-zinc-800 text-zinc-300 text-[10px] px-2 py-1 rounded font-bold">
                ID: <%= u.id %>
              </span>
            </div>

            <div class="space-y-2 mb-4 text-sm text-zinc-400">
              <div class="flex justify-between bg-zinc-950 p-2 rounded">
                <span>Sucursales creadas:</span>
                <span class="font-bold text-white"><%= u.total_sucursales %></span>
              </div>
              <div class="flex justify-between bg-zinc-950 p-2 rounded">
                <span>Estado actual:</span>
                <% if (diasRestantes > 0) { %>
                  <span class="font-bold text-green-400">Prueba (<%= diasRestantes %> días)</span>
                <% } else { %>
                  <span class="font-bold text-red-400">Prueba Finalizada</span>
                <% } %>
              </div>
              <div class="flex justify-between bg-zinc-950 p-2 rounded">
                <span>Cuota a cobrar:</span>
                <span class="font-bold text-orange-400">$<%= cuotaMensual.toLocaleString('es-AR') %></span>
              </div>
            </div>

            <!-- Botón de Contacto -->
            <a href="https://wa.me/<%= u.whatsapp %>?text=Hola!%20Nos%20comunicamos%20desde%20BookBarber%20(MedinSur%20Dev)." target="_blank" class="block w-full bg-green-600/10 hover:bg-green-600/20 border border-green-600/30 text-green-500 text-center py-2 rounded-lg text-sm font-bold transition">
              <i class="fab fa-whatsapp mr-1"></i> Contactar Cliente
            </a>
          </div>
        <% }) %>
      </div>
    </div>

    <footer class="mt-12 border-t border-zinc-800 pt-6 text-center text-zinc-500 text-xs font-medium">
      <p>&copy; <%= new Date().getFullYear() %> MedinSur Dev. Todos los derechos reservados.</p>
    </footer>
  </div>
</body>
</html>
