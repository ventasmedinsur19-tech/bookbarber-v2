<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff - BookBarber</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://widget.cloudinary.com/v2.0/global/all.js" type="text/javascript"></script>
  <style>
    body { background-color: #121214; color: #e1e1e6; }
  </style>
</head>
<body class="p-4 min-h-screen font-sans">

  <div class="max-w-md mx-auto flex justify-between items-center mb-6">
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-bold text-white">Staff</h1>
      <button onclick="toggleInfoModal()" class="w-6 h-6 rounded-full bg-zinc-800 hover:bg-zinc-700 text-orange-500 font-bold text-sm flex items-center justify-center transition">
        i
      </button>
    </div>
    <a href="/dashboard" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-sm text-zinc-300 font-medium rounded-lg transition border border-zinc-700">
      ← Volver al Dashboard
    </a>
  </div>

  <div class="max-w-md mx-auto space-y-6">

    <div id="infoModal" class="hidden bg-zinc-900 border border-orange-500/30 rounded-xl p-4 shadow-xl">
      <div class="flex justify-between items-start mb-2">
        <h3 class="text-orange-500 font-bold flex items-center gap-2">💡 ¿Qué hacer en esta sección?</h3>
        <button onclick="toggleInfoModal()" class="text-zinc-400 hover:text-white font-bold">✕</button>
      </div>
      <p class="text-sm text-zinc-300 leading-relaxed">
        Acá podés agregar a los profesionales que trabajan en tus sucursales. Cada barbero debe estar asignado a un local específico. Podés actualizar sus nombres, cambiar sus fotos de perfil o darlos de baja si ya no forman parte del equipo.
      </p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl shadow-lg">
      <h2 class="text-lg font-semibold text-orange-500 mb-4">Nuevo Profesional</h2>
      <form action="/staff/guardar" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Sucursal</label>
          <select name="sucursal_id" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
            <% sucursales.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Nombre Completo</label>
          <input type="text" name="nombre" placeholder="Ej: Lucas Martínez" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-orange-500 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Foto de Perfil</label>
          <button type="button" onclick="subirFoto()" class="w-full bg-zinc-800 border border-dashed border-zinc-600 p-3 rounded-lg text-sm text-zinc-300 hover:bg-zinc-700 transition flex items-center justify-center gap-2">
            <i class="fas fa-camera text-orange-500"></i> <span id="txt-foto">Subir Foto</span>
          </button>
          <input type="hidden" name="foto_url" id="input-foto">
        </div>
        <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white font-semibold py-2.5 rounded-lg transition text-sm shadow-md shadow-orange-900/20 mt-2">
          Registrar Staff
        </button>
      </form>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-semibold text-zinc-400 tracking-wider uppercase mb-1">Tu Equipo</h2>
      
      <% if (barberos.length === 0) { %>
        <p class="text-zinc-500 text-sm italic text-center py-4">No tenés profesionales registrados todavía.</p>
      <% } %>

      <div class="grid grid-cols-1 gap-3">
        <% barberos.forEach(b => { %>
          <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 flex flex-col gap-3 shadow-md">
            <div class="flex items-center gap-4">
              <img src="<%= b.foto_url || 'https://via.placeholder.com/100?text=Barbero' %>" class="w-14 h-14 rounded-full object-cover border-2 border-orange-500/50 bg-zinc-800">
              <div class="flex-1">
                <h3 class="font-bold text-white text-base"><%= b.nombre %></h3>
                <span class="inline-block mt-1 text-[10px] font-bold tracking-wide uppercase text-orange-400 bg-orange-950/40 px-2 py-0.5 rounded border border-orange-900/30">
                  <%= b.sucursal_nombre %>
                </span>
              </div>
            </div>

            <div class="flex gap-2 border-t border-zinc-800/80 pt-3 mt-1">
              <button onclick="openEditModal('<%= b.id %>', '<%= b.nombre %>', '<%= b.foto_url %>')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs py-2 rounded-lg font-medium transition text-center">
                ✏️ Editar
              </button>
              <form action="/staff/eliminar/<%= b.id %>" method="POST" class="flex-1" onsubmit="return confirm('¿Seguro que querés eliminar a este profesional? Se borrarán sus horarios asignados.');">
                <button type="submit" class="w-full bg-red-950/40 hover:bg-red-900/40 text-red-400 border border-red-900/30 text-xs py-2 rounded-lg font-medium transition">
                  🗑️ Eliminar
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div id="editModal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 w-full max-w-sm shadow-2xl">
      <h3 class="text-lg font-bold text-orange-500 mb-4">Editar Profesional</h3>
      <form id="editForm" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">Nombre Completo</label>
          <input type="text" id="editNombre" name="nombre" required class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-zinc-400 mb-1">URL de la Foto</label>
          <input type="url" id="editFotoUrl" name="foto_url" placeholder="https://..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-orange-500">
          <p class="text-[10px] text-zinc-500 mt-1">Podés pegar un link directo o dejar la foto actual.</p>
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="closeEditModal()" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 py-2 rounded-lg text-sm font-medium transition">
            Cancelar
          </button>
          <button type="submit" class="flex-1 bg-orange-600 hover:bg-orange-500 text-white py-2 rounded-lg text-sm font-medium transition">
            Actualizar
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Mostrar/Ocultar Info
    function toggleInfoModal() {
      const modal = document.getElementById('infoModal');
      modal.classList.toggle('hidden');
    }

    // Modal de Edición
    function openEditModal(id, nombre, foto) {
      document.getElementById('editForm').action = `/staff/editar/${id}`;
      document.getElementById('editNombre').value = nombre;
      document.getElementById('editFotoUrl').value = foto === 'null' ? '' : foto;
      document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
    }

    // Cloudinary para Nuevo Barbero
    function subirFoto() {
      cloudinary.openUploadWidget({
        cloudName: 'daffkqpnx',
        uploadPreset: 'bookbarber',
        sources: ['local', 'camera'],
        cropping: true,
        croppingAspectRatio: 1,
        multiple: false
      }, (error, result) => {
        if (!error && result && result.event === "success") { 
          document.getElementById('input-foto').value = result.info.secure_url;
          const txtFoto = document.getElementById('txt-foto');
          txtFoto.innerText = "¡Foto Cargada!";
          txtFoto.classList.remove('text-zinc-300');
          txtFoto.classList.add('text-green-500');
        }
      });
    }
  </script>
</body>
</html>
