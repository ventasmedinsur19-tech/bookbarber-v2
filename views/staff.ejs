<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Staff | BookBarber</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>

    body {
      background-color: #0a0a0a;
      color: #e5e5e5;
    }

    * {
      -webkit-tap-highlight-color: transparent;
    }

    input[type="file"] {
      display: none;
    }

  </style>

</head>

<body class="min-h-screen font-sans">

  <main
    class="max-w-6xl mx-auto px-4 py-6 md:px-8 md:py-10"
  >

    <!-- HEADER -->

    <header
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-7"
    >

      <div>

        <div class="flex items-center gap-2">

          <h1
            class="text-2xl md:text-3xl font-black text-white"
          >
            Staff
          </h1>

          <button
            type="button"
            onclick="toggleInfoModal()"
            class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-orange-500 font-black text-sm flex items-center justify-center transition"
          >
            i
          </button>

        </div>

        <p
          class="text-xs md:text-sm text-zinc-500 mt-1"
        >
          Administrá los profesionales de tu equipo.
        </p>

      </div>

      <a
        href="/dashboard"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-sm text-zinc-300 font-bold rounded-xl transition border border-zinc-800"
      >

        <i class="fas fa-arrow-left"></i>

        Volver al Dashboard

      </a>

    </header>


    <!-- INFO -->

    <section
      id="infoModal"
      class="hidden mb-6 bg-zinc-900 border border-orange-500/30 rounded-2xl p-5 shadow-xl"
    >

      <div
        class="flex justify-between items-start gap-4"
      >

        <div>

          <h3
            class="text-orange-500 font-black mb-2"
          >

            <i class="fas fa-circle-info mr-1"></i>

            ¿Qué podés hacer acá?

          </h3>

          <p
            class="text-sm text-zinc-300 leading-relaxed"
          >
            Registrá a cada profesional, asignalo a su
            sucursal y definí cada cuántos minutos podrá
            recibir un turno.

            También podés cargar su foto directamente
            desde la galería del celular.
          </p>

        </div>

        <button
          type="button"
          onclick="toggleInfoModal()"
          class="text-zinc-500 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>

    </section>


    <!-- CONTENIDO -->

    <div
      class="grid grid-cols-1 lg:grid-cols-[390px_1fr] gap-6"
    >

      <!-- NUEVO PROFESIONAL -->

      <section
        class="bg-zinc-900 border border-zinc-800 p-5 md:p-6 rounded-2xl shadow-lg h-fit"
      >

        <div
          class="flex items-center gap-3 mb-5"
        >

          <div
            class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500"
          >

            <i class="fas fa-user-plus"></i>

          </div>

          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Nuevo Profesional
            </h2>

            <p class="text-xs text-zinc-500">
              Agregá un integrante al equipo.
            </p>

          </div>

        </div>


        <% if (!sucursales || sucursales.length === 0) { %>

          <div
            class="bg-orange-500/10 border border-orange-500/20 rounded-xl p-4"
          >

            <p
              class="text-sm text-orange-400 font-bold"
            >
              Primero necesitás crear una sucursal.
            </p>

            <a
              href="/sucursales"
              class="inline-block mt-3 text-xs font-black text-white underline"
            >
              Ir a Sucursales
            </a>

          </div>

        <% } else { %>


          <form
            action="/staff/guardar"
            method="POST"
            enctype="multipart/form-data"
            class="space-y-4"
          >

            <!-- SUCURSAL -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Sucursal
              </label>

              <select
                name="sucursal_id"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
              >

                <% sucursales.forEach(s => { %>

                  <option value="<%= s.id %>">
                    <%= s.nombre %>
                  </option>

                <% }) %>

              </select>

            </div>


            <!-- NOMBRE -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Nombre Completo
              </label>

              <input
                type="text"
                name="nombre"
                placeholder="Ej: Lucas Martínez"
                maxlength="100"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-orange-500 text-sm"
              >

            </div>


            <!-- INTERVALO -->

            <div>

              <label
                class="block text-xs font-bold text-zinc-400 mb-1.5"
              >
                Intervalo entre Turnos
              </label>

              <select
                name="intervalo_minutos"
                required
                class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
              >

                <option value="15">
                  Cada 15 minutos
                </option>

                <option value="20">
                  Cada 20 minutos
                </option>

                <option
                  value="30"
                  selected
                >
                  Cada 30 minutos
                </option>

                <option value="45">
                  Cada 45 minutos
                </option>

                <option value="60">
                  Cada 60 minutos
                </option>

              </select>

              <p
                class="text-[10px] text-zinc-600 mt-1.5"
              >
                Se utilizará para organizar su disponibilidad.
              </p>

            </div>


            <!-- FOTO -->

            <div>

              <p
                class="block text-xs font-bold text-zinc-400 mb-2"
              >
                Foto de Perfil
                <span class="text-zinc-600 font-normal">
                  (opcional)
                </span>
              </p>

              <label
                for="foto"
                class="cursor-pointer block bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl overflow-hidden transition"
              >

                <div
                  id="fotoPlaceholder"
                  class="text-center p-5"
                >

                  <div
                    class="w-14 h-14 mx-auto bg-zinc-900 rounded-full flex items-center justify-center mb-3 text-orange-500"
                  >

                    <i
                      class="fas fa-camera text-xl"
                    ></i>

                  </div>

                  <p
                    class="text-sm font-bold text-white"
                  >
                    Elegir Foto
                  </p>

                  <p
                    class="text-[10px] text-zinc-500 mt-1"
                  >
                    Seleccioná una imagen desde tu galería
                  </p>

                </div>

                <div
                  id="fotoPreviewContenedor"
                  class="hidden p-4 text-center"
                >

                  <img
                    id="fotoPreview"
                    class="w-28 h-28 mx-auto rounded-full object-cover border-2 border-orange-500"
                  >

                  <p
                    class="text-xs text-green-400 font-bold mt-3"
                  >
                    <i class="fas fa-check mr-1"></i>
                    Foto seleccionada
                  </p>

                  <p
                    class="text-[10px] text-zinc-500 mt-1"
                  >
                    Tocá nuevamente para cambiarla
                  </p>

                </div>

              </label>

              <input
                type="file"
                id="foto"
                name="foto"
                accept="image/jpeg,image/png,image/webp"
                onchange="previewImagen(this)"
              >

            </div>


            <!-- AVISO -->

            <div
              class="bg-blue-500/5 border border-blue-500/10 rounded-xl p-3"
            >

              <p
                class="text-[10px] text-blue-400 leading-relaxed"
              >

                <i
                  class="fas fa-wand-magic-sparkles mr-1"
                ></i>

                BookBarber comprimirá automáticamente
                la foto antes de guardarla.

              </p>

            </div>


            <button
              type="submit"
              class="w-full bg-orange-600 hover:bg-orange-500 text-white font-black py-3 rounded-xl transition text-sm shadow-md shadow-orange-900/20"
            >

              <i class="fas fa-user-plus mr-2"></i>

              Registrar Staff

            </button>

          </form>

        <% } %>

      </section>


      <!-- EQUIPO -->

      <section>

        <div
          class="flex items-center justify-between gap-4 mb-4"
        >

          <div>

            <h2
              class="text-lg font-black text-white"
            >
              Tu Equipo
            </h2>

            <p
              class="text-xs text-zinc-500 mt-1"
            >
              <%= barberos.length %>
              profesional(es)
            </p>

          </div>

        </div>


        <% if (!barberos || barberos.length === 0) { %>

          <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl p-10 text-center"
          >

            <div
              class="w-16 h-16 mx-auto rounded-full bg-zinc-800 flex items-center justify-center mb-4"
            >

              <i
                class="fas fa-users text-2xl text-zinc-600"
              ></i>

            </div>

            <p
              class="text-zinc-500 text-sm"
            >
              No tenés profesionales registrados todavía.
            </p>

          </div>

        <% } %>


        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-4"
        >

          <% barberos.forEach(b => { %>

            <article
              class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 shadow-lg"
            >

              <div
                class="flex items-center gap-4"
              >

                <!-- FOTO -->

                <div
                  class="w-16 h-16 shrink-0 rounded-full overflow-hidden bg-zinc-800 border-2 border-orange-500/40"
                >

                  <% if (b.foto_url) { %>

                    <img
                      src="<%= b.foto_url %>?v=<%= Date.now() %>"
                      alt="<%= b.nombre %>"
                      class="w-full h-full object-cover"
                    >

                  <% } else { %>

                    <div
                      class="w-full h-full flex items-center justify-center text-zinc-500"
                    >

                      <i
                        class="fas fa-user text-2xl"
                      ></i>

                    </div>

                  <% } %>

                </div>


                <!-- INFO -->

                <div class="min-w-0 flex-1">

                  <h3
                    class="font-black text-white text-lg truncate"
                  >
                    <%= b.nombre %>
                  </h3>

                  <span
                    class="inline-flex items-center mt-1 text-[9px] font-black tracking-wide uppercase text-orange-400 bg-orange-500/10 px-2 py-1 rounded-lg border border-orange-500/20"
                  >

                    <i
                      class="fas fa-store mr-1"
                    ></i>

                    <%= b.sucursal_nombre %>

                  </span>

                </div>

              </div>


              <!-- INTERVALO -->

              <div
                class="bg-black/40 border border-zinc-800 rounded-xl p-3 my-4 flex items-center justify-between"
              >

                <span
                  class="text-xs text-zinc-500"
                >

                  <i
                    class="fas fa-clock mr-1 text-orange-500"
                  ></i>

                  Intervalo

                </span>

                <span
                  class="text-xs font-black text-white"
                >
                  <%= b.intervalo_minutos || 30 %> min
                </span>

              </div>


              <!-- ACCIONES -->

              <div
                class="grid grid-cols-2 gap-2"
              >

                <button
                  type="button"
                  onclick="openEditModal(this)"

                  data-id="<%= b.id %>"

                  data-nombre="<%= encodeURIComponent(b.nombre || '') %>"

                  data-foto="<%= encodeURIComponent(b.foto_url || '') %>"

                  data-sucursal="<%= b.sucursal_id %>"

                  data-intervalo="<%= b.intervalo_minutos || 30 %>"

                  class="bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs py-2.5 rounded-xl font-bold transition"
                >

                  <i
                    class="fas fa-pen mr-1"
                  ></i>

                  Editar

                </button>


                <form
                  action="/staff/eliminar/<%= b.id %>"
                  method="POST"
                  onsubmit="return confirm('¿Seguro que querés eliminar a este profesional? Sus horarios asociados también serán eliminados.');"
                >

                  <button
                    type="submit"
                    class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs py-2.5 rounded-xl font-bold transition"
                  >

                    <i
                      class="fas fa-trash mr-1"
                    ></i>

                    Eliminar

                  </button>

                </form>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    </div>


    <!-- FOOTER -->

    <footer
      class="mt-12 pt-6 border-t border-zinc-900 text-center text-[10px] text-zinc-600"
    >

      © <%= new Date().getFullYear() %>
      MedinSur Dev · BookBarber

    </footer>

  </main>


  <!-- =====================================================
       MODAL EDICIÓN
  ====================================================== -->

  <div
    id="editModal"
    class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto"
  >

    <div
      class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5 md:p-6 w-full max-w-md shadow-2xl my-6"
    >

      <div
        class="flex items-center justify-between mb-5"
      >

        <div>

          <h3
            class="text-lg font-black text-white"
          >
            Editar Profesional
          </h3>

          <p
            class="text-xs text-zinc-500 mt-1"
          >
            Modificá sus datos o reemplazá su foto.
          </p>

        </div>

        <button
          type="button"
          onclick="closeEditModal()"
          class="w-9 h-9 rounded-xl bg-zinc-800 text-zinc-400 hover:text-white"
        >

          <i class="fas fa-xmark"></i>

        </button>

      </div>


      <form
        id="editForm"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-4"
      >

        <!-- SUCURSAL -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Sucursal
          </label>

          <select
            id="editSucursal"
            name="sucursal_id"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

            <% sucursales.forEach(s => { %>

              <option value="<%= s.id %>">
                <%= s.nombre %>
              </option>

            <% }) %>

          </select>

        </div>


        <!-- NOMBRE -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Nombre Completo
          </label>

          <input
            type="text"
            id="editNombre"
            name="nombre"
            maxlength="100"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

        </div>


        <!-- INTERVALO -->

        <div>

          <label
            class="block text-xs font-bold text-zinc-400 mb-1.5"
          >
            Intervalo entre Turnos
          </label>

          <select
            id="editIntervalo"
            name="intervalo_minutos"
            required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-3 text-white text-sm focus:outline-none focus:border-orange-500"
          >

            <option value="15">
              Cada 15 minutos
            </option>

            <option value="20">
              Cada 20 minutos
            </option>

            <option value="30">
              Cada 30 minutos
            </option>

            <option value="45">
              Cada 45 minutos
            </option>

            <option value="60">
              Cada 60 minutos
            </option>

          </select>

        </div>


        <!-- FOTO ACTUAL -->

        <div>

          <p
            class="block text-xs font-bold text-zinc-400 mb-2"
          >
            Foto de Perfil
          </p>

          <div
            id="editFotoActualContenedor"
            class="hidden text-center mb-3"
          >

            <img
              id="editFotoActual"
              class="w-24 h-24 mx-auto rounded-full object-cover border-2 border-orange-500/50"
            >

            <p
              class="text-[10px] text-zinc-500 mt-2"
            >
              Foto actual
            </p>

          </div>


          <label
            for="editFoto"
            class="cursor-pointer flex items-center justify-center gap-2 bg-zinc-950 border border-dashed border-zinc-700 hover:border-orange-500 rounded-xl p-4 transition"
          >

            <i
              class="fas fa-camera text-orange-500"
            ></i>

            <span
              id="editFotoTexto"
              class="text-xs font-bold text-zinc-300"
            >
              Elegir nueva foto
            </span>

          </label>


          <input
            type="file"
            id="editFoto"
            name="foto"
            accept="image/jpeg,image/png,image/webp"
            onchange="previewEditImagen(this)"
          >

          <p
            class="text-[10px] text-zinc-600 mt-2"
          >
            Si no elegís otra imagen, se conservará
            la actual.
          </p>

        </div>


        <!-- BOTONES -->

        <div
          class="grid grid-cols-2 gap-2 pt-2"
        >

          <button
            type="button"
            onclick="closeEditModal()"
            class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 py-3 rounded-xl text-sm font-bold"
          >
            Cancelar
          </button>

          <button
            type="submit"
            class="bg-orange-600 hover:bg-orange-500 text-white py-3 rounded-xl text-sm font-black"
          >
            Actualizar
          </button>

        </div>

      </form>

    </div>

  </div>


  <!-- JAVASCRIPT -->

  <script>

    function toggleInfoModal() {

      document
        .getElementById('infoModal')
        .classList.toggle('hidden');

    }


    function previewImagen(input) {

      if (
        !input.files ||
        !input.files[0]
      ) {
        return;
      }

      const reader =
        new FileReader();

      reader.onload =
        function(event) {

          const preview =
            document.getElementById(
              'fotoPreview'
            );

          preview.src =
            event.target.result;

          document
            .getElementById(
              'fotoPlaceholder'
            )
            .classList.add('hidden');

          document
            .getElementById(
              'fotoPreviewContenedor'
            )
            .classList.remove('hidden');

        };

      reader.readAsDataURL(
        input.files[0]
      );
    }


    function openEditModal(button) {

      const id =
        button.dataset.id;

      const nombre =
        decodeURIComponent(
          button.dataset.nombre || ''
        );

      const foto =
        decodeURIComponent(
          button.dataset.foto || ''
        );

      const sucursal =
        button.dataset.sucursal;

      const intervalo =
        button.dataset.intervalo || '30';


      document
        .getElementById('editForm')
        .action =
          `/staff/editar/${id}`;


      document
        .getElementById('editNombre')
        .value =
          nombre;


      document
        .getElementById('editSucursal')
        .value =
          sucursal;


      document
        .getElementById('editIntervalo')
        .value =
          intervalo;


      document
        .getElementById('editFoto')
        .value = '';


      document
        .getElementById('editFotoTexto')
        .textContent =
          'Elegir nueva foto';


      const contenedor =
        document.getElementById(
          'editFotoActualContenedor'
        );

      const imagen =
        document.getElementById(
          'editFotoActual'
        );


      if (foto) {

        imagen.src =
          foto +
          '?v=' +
          Date.now();

        contenedor
          .classList.remove('hidden');

      } else {

        contenedor
          .classList.add('hidden');

      }


      document
        .getElementById('editModal')
        .classList.remove('hidden');


      document.body.style.overflow =
        'hidden';
    }


    function previewEditImagen(input) {

      if (
        !input.files ||
        !input.files[0]
      ) {
        return;
      }


      const reader =
        new FileReader();


      reader.onload =
        function(event) {

          const contenedor =
            document.getElementById(
              'editFotoActualContenedor'
            );

          const imagen =
            document.getElementById(
              'editFotoActual'
            );


          imagen.src =
            event.target.result;


          contenedor
            .classList.remove('hidden');


          document
            .getElementById(
              'editFotoTexto'
            )
            .textContent =
              'Foto seleccionada ✓';

        };


      reader.readAsDataURL(
        input.files[0]
      );
    }


    function closeEditModal() {

      document
        .getElementById('editModal')
        .classList.add('hidden');


      document.body.style.overflow =
        '';

    }


    document.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Escape'
        ) {
          closeEditModal();
        }

      }
    );

  </script>

</body>

</html>
