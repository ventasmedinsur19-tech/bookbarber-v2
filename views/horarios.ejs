<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Horarios - BookBarber</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Estilo para colapsables */
    .collapse-content { display: none; }
    .collapse-open .collapse-content { display: block; }
  </style>
</head>
<body class="bg-zinc-950 text-zinc-100 p-4">

  <div class="max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-6 text-white">Agenda por Profesional</h1>

    <% 
      // Agrupamos barberos por sucursal para la vista jerárquica
      const porSucursal = {};
      barberos.forEach(b => {
        if (!porSucursal[b.sucursal_nombre]) porSucursal[b.sucursal_nombre] = [];
        porSucursal[b.sucursal_nombre].push(b);
      });
    %>

    <div class="space-y-4">
      <% Object.keys(porSucursal).forEach(sucursal => { %>
        <div class="border border-zinc-800 rounded-xl overflow-hidden bg-zinc-900">
          <div class="bg-zinc-800 px-4 py-3 border-b border-zinc-700 font-bold text-orange-500 uppercase tracking-wider text-sm">
            <%= sucursal %>
          </div>

          <% porSucursal[sucursal].forEach(barbero => { %>
            <div class="border-b border-zinc-800 last:border-0" id="barbero-<%= barbero.id %>">
              <button onclick="toggleBarbero(<%= barbero.id %>)" class="w-full flex justify-between items-center p-4 hover:bg-zinc-800/50 transition">
                <span class="font-medium text-zinc-200"><%= barbero.nombre %></span>
                <span class="text-zinc-500 text-xs">⬇️</span>
              </button>
              
              <div class="collapse-content bg-zinc-950 p-4 border-t border-zinc-800">
                <div class="text-xs text-zinc-400 mb-4">
                  Horarios configurados:
                  <ul class="mt-2 space-y-1">
                    <% 
                      const horariosBarbero = horarios.filter(h => h.barbero_id === barbero.id);
                      if(horariosBarbero.length === 0) { %> <li class="italic text-zinc-600">Sin horarios</li> <% }
                      horariosBarbero.forEach(h => { 
                    %>
                      <li class="flex justify-between bg-zinc-900 p-2 rounded">
                        <span><%= h.dia %>: <%= h.hora_inicio.substring(0,5) %> - <%= h.hora_fin.substring(0,5) %></span>
                        <form action="/horarios/eliminar/<%= h.id %>" method="POST">
                          <button class="text-red-500 font-bold">✕</button>
                        </form>
                      </li>
                    <% }) %>
                  </ul>
                </div>
                
                <a href="/horarios/nuevo?barbero_id=<%= barbero.id %>" class="block w-full text-center py-2 bg-orange-600 rounded-lg text-sm font-bold">
                  Editar / Añadir Horarios
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>

  <script>
    function toggleBarbero(id) {
      const container = document.getElementById('barbero-' + id);
      container.classList.toggle('collapse-open');
    }
  </script>
</body>
</html>
