<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horarios | BookBarber Online</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        bbDark: '#0a0a0a',
                        bbCard: '#141414',
                        bbBorder: '#262626',
                        bbAccent: '#f97316'
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0a0a0a; color: #e5e5e5; }
        .glass-card { background: rgba(20, 20, 20, 0.7); backdrop-filter: blur(10px); border: 1px solid #262626; }
    </style>
</head>
<body class="font-sans antialiased min-h-screen p-4 md:p-8">
    <div class="max-w-5xl mx-auto">
        
        <div class="flex items-center justify-between mb-10 border-b border-bbBorder pb-6">
            <div class="flex items-center gap-4">
                <a href="/dashboard" class="flex items-center justify-center w-10 h-10 rounded-xl bg-bbBorder text-gray-400 hover:text-bbAccent transition-all">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-black text-white">Gestión de Horarios</h1>
                    <button onclick="toggleInfoModal()" class="text-[10px] text-bbAccent font-bold hover:underline">¿Qué hago acá? (i)</button>
                </div>
            </div>
        </div>

        <div id="infoModal" class="hidden glass-card p-4 rounded-xl border border-bbAccent/30 mb-8">
            <h3 class="text-bbAccent font-bold mb-2">💡 ¿Cómo funciona?</h3>
            <p class="text-sm text-gray-400">Definí el horario de atención para cada profesional. Esto permitirá que los clientes vean disponibilidad real al momento de reservar. Podés editar o borrar turnos laborales existentes en cualquier momento.</p>
        </div>

        <div class="glass-card p-6 md:p-8 rounded-2xl mb-12 shadow-lg">
            <h2 class="text-lg font-bold text-white mb-6">Añadir Nuevo Turno Laboral</h2>
            <form action="/horarios/guardar" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="md:col-span-4">
                    <label class="block text-xs text-gray-500 mb-2 font-bold uppercase">Asignar a Barbero</label>
                    <select name="barbero_id" required class="w-full bg-bbDark border border-bbBorder rounded-xl p-4 text-sm text-white focus:border-bbAccent outline-none">
                        <% barberos.forEach(b => { %>
                            <option value="<%= b.id %>"><%= b.nombre %> (<%= b.sucursal_nombre %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs text-gray-500 mb-2 font-bold uppercase">Día</label>
                    <select name="dia" required class="w-full bg-bbDark border border-bbBorder rounded-xl p-4 text-sm text-white focus:border-bbAccent outline-none">
                        <option value="Lunes">Lunes</option><option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option><option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option><option value="Sábado">Sábado</option><option value="Domingo">Domingo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 mb-2 font-bold uppercase">Apertura</label>
                    <input type="time" name="hora_inicio" required class="w-full bg-bbDark border border-bbBorder rounded-xl p-4 text-sm text-white focus:border-bbAccent outline-none" style="color-scheme: dark;">
                </div>
                <div>
                    <label class="block text-xs text-gray-500 mb-2 font-bold uppercase">Cierre</label>
                    <input type="time" name="hora_fin" required class="w-full bg-bbDark border border-bbBorder rounded-xl p-4 text-sm text-white focus:border-bbAccent outline-none" style="color-scheme: dark;">
                </div>
                <button type="submit" class="md:col-span-4 bg-bbAccent text-black font-black uppercase py-4 rounded-xl hover:bg-orange-600 transition-all">Guardar Horario</button>
            </form>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <% horarios.forEach(h => { %>
                <div class="glass-card p-5 rounded-2xl relative">
                    <span class="text-[10px] text-gray-500 font-bold uppercase"><%= h.sucursal_nombre %></span>
                    <h4 class="font-black text-white text-lg mb-4"><%= h.dia %></h4>
                    <p class="text-sm text-gray-300 font-semibold mb-4"><i class="fas fa-user text-bbAccent mr-2"></i> <%= h.barbero_nombre %></p>
                    <div class="flex items-center justify-between text-sm text-gray-400 mb-4 bg-bbDark p-2 rounded-lg">
                        <span><%= h.hora_inicio.substring(0,5) %></span>
                        <i class="fas fa-arrow-right text-[10px]"></i>
                        <span><%= h.hora_fin.substring(0,5) %></span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="openEditModal('<%= h.id %>', '<%= h.dia %>', '<%= h.hora_inicio %>', '<%= h.hora_fin %>')" class="flex-1 bg-bbBorder py-2 rounded-lg text-xs hover:bg-zinc-700">✏️ Editar</button>
                        <form action="/horarios/eliminar/<%= h.id %>" method="POST" class="flex-1" onsubmit="return confirm('¿Eliminar este horario?');">
                            <button type="submit" class="w-full bg-red-900/20 text-red-500 py-2 rounded-lg text-xs hover:bg-red-900/40">🗑️ Borrar</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div id="editModal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-50">
        <div class="glass-card p-6 rounded-2xl w-full max-w-sm">
            <h3 class="font-bold text-white mb-4">Editar Horario</h3>
            <form id="editForm" method="POST" class="space-y-4">
                <select name="dia" id="editDia" class="w-full bg-bbDark border border-bbBorder p-3 rounded-lg text-white">
                    <option value="Lunes">Lunes</option><option value="Martes">Martes</option>
                    <option value="Miércoles">Miércoles</option><option value="Jueves">Jueves</option>
                    <option value="Viernes">Viernes</option><option value="Sábado">Sábado</option><option value="Domingo">Domingo</option>
                </select>
                <input type="time" name="hora_inicio" id="editInicio" class="w-full bg-bbDark border border-bbBorder p-3 rounded-lg text-white" style="color-scheme: dark;">
                <input type="time" name="hora_fin" id="editFin" class="w-full bg-bbDark border border-bbBorder p-3 rounded-lg text-white" style="color-scheme: dark;">
                <div class="flex gap-2">
                    <button type="button" onclick="closeEditModal()" class="flex-1 bg-bbBorder py-2 rounded-lg">Cancelar</button>
                    <button type="submit" class="flex-1 bg-bbAccent py-2 rounded-lg text-black font-bold">Actualizar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleInfoModal() { document.getElementById('infoModal').classList.toggle('hidden'); }
        function openEditModal(id, dia, inicio, fin) {
            document.getElementById('editForm').action = `/horarios/editar/${id}`;
            document.getElementById('editDia').value = dia;
            document.getElementById('editInicio').value = inicio.substring(0,5);
            document.getElementById('editFin').value = fin.substring(0,5);
            document.getElementById('editModal').classList.remove('hidden');
        }
        function closeEditModal() { document.getElementById('editModal').classList.add('hidden'); }
    </script>
</body>
</html>
