<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Turnos | BookBarber</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    body { background:#0a0a0a; color:#e5e5e5; }
    * { -webkit-tap-highlight-color:transparent; }
    .tab-activo {
      background:#ea580c;
      color:#fff;
      border-color:#f97316;
    }
  </style>
</head>

<body class="min-h-screen font-sans">

<%
  const fechaHoy = hoy;
  const estructura = {};

  const normalizarFecha = (valor) => {
    if (!valor) return '';

    if (valor instanceof Date) {
      return [
        valor.getFullYear(),
        String(valor.getMonth() + 1).padStart(2, '0'),
        String(valor.getDate()).padStart(2, '0')
      ].join('-');
    }

    return String(valor).substring(0, 10);
  };

  const fechaBonita = (fecha) => {
    const partes = String(fecha || '').split('-');
    if (partes.length !== 3) return fecha || '';
    return `${partes[2]}/${partes[1]}/${partes[0]}`;
  };

  const turnosPreparados = (turnos || []).map(t => {
    const fechaTurno = normalizarFecha(t.fecha);

    let segmento = 'hoy';
    if (fechaTurno > fechaHoy) segmento = 'futuros';
    if (fechaTurno < fechaHoy) segmento = 'anteriores';

    return {
      id: t.id,
      sucursal_id: t.sucursal_id,
      sucursal_nombre: t.sucursal_nombre || 'Sucursal',
      barbero_nombre: t.barbero_nombre || 'Profesional',
      cliente_nombre: t.cliente_nombre || 'Cliente',
      cliente_whatsapp: t.cliente_whatsapp || '',
      servicio_nombre: t.servicio_nombre || 'Servicio',
      precio: Number(t.precio || 0),
      duracion: Number(t.duracion_minutos || 30),
      hora: String(t.hora || '').substring(0, 5),
      fecha: fechaTurno,
      estado: t.estado || 'pendiente',
      segmento
    };
  });

  turnosPreparados.forEach(t => {
    if (!estructura[t.sucursal_nombre]) {
      estructura[t.sucursal_nombre] = {};
    }

    if (!estructura[t.sucursal_nombre][t.barbero_nombre]) {
      estructura[t.sucursal_nombre][t.barbero_nombre] = [];
    }

    estructura[t.sucursal_nombre][t.barbero_nombre].push(t);
  });

  const totalHoy = turnosPreparados.filter(t => t.segmento === 'hoy').length;
  const pendientesHoy = turnosPreparados.filter(
    t => t.segmento === 'hoy' && t.estado === 'pendiente'
  ).length;
  const realizadosHoy = turnosPreparados.filter(
    t => t.segmento === 'hoy' && t.estado === 'exito'
  ).length;
  const canceladosHoy = turnosPreparados.filter(
    t => t.segmento === 'hoy' && t.estado === 'cancelado'
  ).length;
%>

<main class="max-w-7xl mx-auto px-4 py-6 md:px-8 md:py-10">

  <!-- HEADER -->
  <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">

    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl md:text-3xl font-black text-white">Turnos</h1>

        <button
          type="button"
          onclick="toggleInfoModal()"
          class="w-7 h-7 rounded-full bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 text-orange-500 font-black text-sm flex items-center justify-center transition"
          aria-label="Información"
        >
          i
        </button>
      </div>

      <p class="text-xs md:text-sm text-zinc-500 mt-1">
        Reservas recibidas desde los links públicos de tus sucursales.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">

      <a
        href="/links"
        class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-orange-600 hover:bg-orange-500 text-white text-sm font-black rounded-xl transition"
      >
        <i class="fas fa-calendar-plus"></i>
        Dar turno
      </a>

      <a
        href="/dashboard"
        class="inline-flex items-center justify-center gap-2 px-4 py-3 bg-zinc-900 hover:bg-zinc-800 text-sm text-zinc-300 font-bold rounded-xl transition border border-zinc-800"
      >
        <i class="fas fa-arrow-left"></i>
        Volver al Dashboard
      </a>

    </div>
  </header>

  <!-- MENSAJES -->
  <% if (error) { %>
    <div class="mb-5 bg-red-500/10 border border-red-500/30 text-red-400 rounded-xl p-4 text-sm font-bold flex items-start gap-3">
      <i class="fas fa-circle-exclamation mt-0.5"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (ok) { %>
    <div class="mb-5 bg-green-500/10 border border-green-500/30 text-green-400 rounded-xl p-4 text-sm font-bold flex items-start gap-3">
      <i class="fas fa-circle-check mt-0.5"></i>
      <span><%= ok %></span>
    </div>
  <% } %>

  <!-- INFO -->
  <section
    id="infoModal"
    class="hidden mb-6 bg-zinc-900 border border-orange-500/30 rounded-2xl p-5"
  >
    <div class="flex justify-between items-start gap-4">
      <div>
        <h3 class="text-orange-500 font-black mb-2">
          <i class="fas fa-circle-info mr-1"></i>
          ¿Cómo funcionan los turnos?
        </h3>

        <p class="text-sm text-zinc-300 leading-relaxed">
          Los clientes reservan desde el link público de cada sucursal y sus turnos aparecen automáticamente acá, separados por sucursal y profesional.
          Si una persona pide un turno directamente en el local, usá el botón <strong class="text-white">Dar turno</strong>: te llevará a los links de tus sucursales para cargar la reserva usando exactamente el mismo sistema que usa el cliente.
        </p>
      </div>

      <button
        type="button"
        onclick="toggleInfoModal()"
        class="text-zinc-500 hover:text-white"
      >
        <i class="fas fa-xmark"></i>
      </button>
    </div>
  </section>

  <!-- RESUMEN DE HOY -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
      <p class="text-[10px] uppercase tracking-widest text-zinc-600 font-black">Turnos hoy</p>
      <p class="text-2xl font-black text-white mt-1"><%= totalHoy %></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
      <p class="text-[10px] uppercase tracking-widest text-yellow-500/70 font-black">Pendientes</p>
      <p class="text-2xl font-black text-yellow-400 mt-1"><%= pendientesHoy %></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
      <p class="text-[10px] uppercase tracking-widest text-green-500/70 font-black">Realizados</p>
      <p class="text-2xl font-black text-green-400 mt-1"><%= realizadosHoy %></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
      <p class="text-[10px] uppercase tracking-widest text-red-500/70 font-black">Cancelados</p>
      <p class="text-2xl font-black text-red-400 mt-1"><%= canceladosHoy %></p>
    </div>

  </section>

  <!-- TABS -->
  <div class="grid grid-cols-3 bg-zinc-900 border border-zinc-800 rounded-xl p-1 mb-5">
    <button
      id="tabHoy"
      type="button"
      onclick="switchView('hoy')"
      class="tab-btn tab-activo border border-transparent rounded-lg px-2 py-2.5 text-xs font-black transition"
    >
      Hoy
    </button>

    <button
      id="tabFuturos"
      type="button"
      onclick="switchView('futuros')"
      class="tab-btn border border-transparent rounded-lg px-2 py-2.5 text-xs font-black text-zinc-500 transition"
    >
      Próximos
    </button>

    <button
      id="tabAnteriores"
      type="button"
      onclick="switchView('anteriores')"
      class="tab-btn border border-transparent rounded-lg px-2 py-2.5 text-xs font-black text-zinc-500 transition"
    >
      Anteriores
    </button>
  </div>

  <!-- LISTADO -->
  <% if (!turnosPreparados.length) { %>

    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-10 text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-zinc-800 flex items-center justify-center mb-4">
        <i class="fas fa-calendar-xmark text-2xl text-zinc-600"></i>
      </div>

      <h2 class="text-white font-black mb-2">Todavía no hay reservas</h2>

      <p class="text-zinc-500 text-sm max-w-md mx-auto">
        Cuando un cliente reserve desde el link público de una sucursal, el turno aparecerá automáticamente en esta pantalla.
      </p>

      <a
        href="/links"
        class="inline-flex items-center gap-2 mt-5 bg-orange-600 hover:bg-orange-500 text-white px-5 py-3 rounded-xl text-sm font-black transition"
      >
        <i class="fas fa-link"></i>
        Ver links de reservas
      </a>
    </div>

  <% } else { %>

    <div id="turnosContenedor" class="space-y-5">

      <% Object.keys(estructura).forEach(sucursal => { %>

        <article class="grupo-sucursal bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">

          <div class="bg-zinc-800/70 border-b border-zinc-800 px-4 py-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <i class="fas fa-store text-orange-500 text-xs"></i>
              <span class="text-xs font-black uppercase tracking-wider text-orange-400 truncate">
                <%= sucursal %>
              </span>
            </div>
          </div>

          <% Object.keys(estructura[sucursal]).forEach(barbero => { %>

            <div class="grupo-barbero border-b last:border-b-0 border-zinc-800 p-4 md:p-5">

              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-500">
                  <i class="fas fa-user text-xs"></i>
                </div>

                <div>
                  <p class="text-sm md:text-base font-black text-white"><%= barbero %></p>
                  <p class="text-[10px] text-zinc-600">Agenda del profesional</p>
                </div>
              </div>

              <div class="space-y-3">

                <% estructura[sucursal][barbero].forEach(turno => {
                  let estadoTexto = 'Pendiente';
                  let estadoClases = 'text-yellow-400 bg-yellow-500/10 border-yellow-500/20';

                  if (turno.estado === 'exito') {
                    estadoTexto = 'Realizado';
                    estadoClases = 'text-green-400 bg-green-500/10 border-green-500/20';
                  }

                  if (turno.estado === 'cancelado') {
                    estadoTexto = 'Cancelado';
                    estadoClases = 'text-red-400 bg-red-500/10 border-red-500/20';
                  }
                %>

                  <div
                    class="turno-card bg-zinc-950 border border-zinc-800 rounded-xl p-4"
                    data-segmento="<%= turno.segmento %>"
                  >

                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">

                      <div class="min-w-0 flex-1">

                        <div class="flex items-center gap-2 flex-wrap">
                          <h3 class="font-black text-white text-base">
                            <%= turno.cliente_nombre %>
                          </h3>

                          <span class="inline-flex border rounded-md px-2 py-0.5 text-[9px] font-black uppercase <%= estadoClases %>">
                            <%= estadoTexto %>
                          </span>
                        </div>

                        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">

                          <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-2.5">
                            <p class="text-[9px] uppercase tracking-wider text-zinc-600 font-black">Servicio</p>
                            <p class="text-xs text-zinc-300 font-bold mt-1">
                              <i class="fas fa-scissors text-orange-500 mr-1"></i>
                              <%= turno.servicio_nombre %>
                            </p>
                          </div>

                          <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-2.5">
                            <p class="text-[9px] uppercase tracking-wider text-zinc-600 font-black">Duración / Valor</p>
                            <p class="text-xs text-zinc-300 font-bold mt-1">
                              <%= turno.duracion %> min ·
                              <span class="text-green-400">$<%= turno.precio.toLocaleString('es-AR') %></span>
                            </p>
                          </div>

                        </div>

                        <% if (turno.cliente_whatsapp) { %>
                          <a
                            href="https://wa.me/<%= String(turno.cliente_whatsapp).replace(/\D/g, '') %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 mt-3 text-xs text-green-500 font-black hover:text-green-400"
                          >
                            <i class="fab fa-whatsapp text-base"></i>
                            <%= turno.cliente_whatsapp %>
                          </a>
                        <% } %>

                      </div>

                      <div class="sm:text-right shrink-0">
                        <div class="inline-flex items-center gap-2 bg-zinc-900 border border-zinc-700 text-white font-black rounded-xl px-3 py-2 text-lg">
                          <i class="far fa-clock text-orange-500 text-sm"></i>
                          <%= turno.hora %>
                        </div>

                        <p class="text-[11px] text-zinc-500 mt-2">
                          <i class="far fa-calendar mr-1"></i>
                          <%= fechaBonita(turno.fecha) %>
                        </p>
                      </div>

                    </div>

                    <!-- ACCIONES -->
                    <div class="mt-4 pt-3 border-t border-zinc-800 flex flex-wrap items-center gap-2">

                      <% if (turno.estado === 'pendiente') { %>

                        <form action="/turnos/estado" method="POST" class="flex-1 sm:flex-none">
                          <input type="hidden" name="turno_id" value="<%= turno.id %>">
                          <input type="hidden" name="nuevo_estado" value="exito">

                          <button
                            type="submit"
                            class="w-full sm:w-auto bg-green-500/10 hover:bg-green-500/20 border border-green-500/20 text-green-400 px-4 py-2.5 rounded-lg text-[10px] font-black"
                          >
                            <i class="fas fa-check mr-1"></i>
                            MARCAR REALIZADO
                          </button>
                        </form>

                        <form
                          action="/turnos/estado"
                          method="POST"
                          class="flex-1 sm:flex-none"
                          onsubmit="return confirm('¿Cancelar este turno? El horario volverá a quedar disponible para nuevas reservas.');"
                        >
                          <input type="hidden" name="turno_id" value="<%= turno.id %>">
                          <input type="hidden" name="nuevo_estado" value="cancelado">

                          <button
                            type="submit"
                            class="w-full sm:w-auto bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 px-4 py-2.5 rounded-lg text-[10px] font-black"
                          >
                            <i class="fas fa-ban mr-1"></i>
                            CANCELAR
                          </button>
                        </form>

                      <% } %>

                      <% if (turno.estado !== 'pendiente') { %>
                        <div class="text-[10px] text-zinc-600 mr-auto">
                          <% if (turno.estado === 'exito') { %>
                            <i class="fas fa-circle-check text-green-500 mr-1"></i>
                            Este turno ya fue realizado.
                          <% } else { %>
                            <i class="fas fa-circle-xmark text-red-500 mr-1"></i>
                            Este turno fue cancelado y su horario quedó liberado.
                          <% } %>
                        </div>
                      <% } %>

                      <form
                        action="/turnos/eliminar/<%= turno.id %>"
                        method="POST"
                        class="ml-auto"
                        onsubmit="return confirm('¿Eliminar definitivamente este registro? Esta acción no se puede deshacer.');"
                      >
                        <button
                          type="submit"
                          class="bg-zinc-800 hover:bg-zinc-700 text-zinc-500 hover:text-red-400 px-3 py-2.5 rounded-lg text-[10px] font-black"
                          title="Eliminar registro"
                        >
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>

                    </div>

                  </div>

                <% }); %>

              </div>
            </div>

          <% }); %>

        </article>

      <% }); %>

    </div>

    <div
      id="sinTurnosSegmento"
      class="hidden bg-zinc-900 border border-zinc-800 rounded-2xl p-8 text-center"
    >
      <i class="fas fa-calendar-day text-3xl text-zinc-700 mb-3"></i>
      <p id="sinTurnosTexto" class="text-sm text-zinc-500"></p>
    </div>

  <% } %>

  <footer class="mt-12 pt-6 border-t border-zinc-900 text-center text-[10px] text-zinc-600">
    © <%= new Date().getFullYear() %> BookBarber · MedinSur Dev
  </footer>

</main>

<script>
  function toggleInfoModal() {
    const modal = document.getElementById('infoModal');
    if (modal) modal.classList.toggle('hidden');
  }

  function switchView(tipo) {
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('tab-activo');
      btn.classList.add('text-zinc-500');
    });

    const tab =
      tipo === 'hoy'
        ? document.getElementById('tabHoy')
        : tipo === 'futuros'
          ? document.getElementById('tabFuturos')
          : document.getElementById('tabAnteriores');

    if (tab) {
      tab.classList.add('tab-activo');
      tab.classList.remove('text-zinc-500');
    }

    document.querySelectorAll('.turno-card').forEach(card => {
      card.classList.toggle(
        'hidden',
        card.dataset.segmento !== tipo
      );
    });

    document.querySelectorAll('.grupo-barbero').forEach(grupo => {
      const visibles = grupo.querySelectorAll('.turno-card:not(.hidden)').length;
      grupo.classList.toggle('hidden', visibles === 0);
    });

    document.querySelectorAll('.grupo-sucursal').forEach(grupo => {
      const visibles = grupo.querySelectorAll('.grupo-barbero:not(.hidden)').length;
      grupo.classList.toggle('hidden', visibles === 0);
    });

    const totalVisibles =
      document.querySelectorAll('.turno-card:not(.hidden)').length;

    const mensaje = document.getElementById('sinTurnosSegmento');
    const texto = document.getElementById('sinTurnosTexto');

    if (mensaje && texto) {
      if (totalVisibles === 0) {
        mensaje.classList.remove('hidden');

        texto.textContent =
          tipo === 'hoy'
            ? 'No hay turnos para hoy.'
            : tipo === 'futuros'
              ? 'No hay próximos turnos.'
              : 'No hay turnos anteriores.';
      } else {
        mensaje.classList.add('hidden');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    switchView('hoy');
  });
</script>

</body>
</html>

