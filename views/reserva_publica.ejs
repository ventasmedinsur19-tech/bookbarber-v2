<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Reservar turno | <%= sucursal.nombre %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #09090b; color: #e4e4e7; }
    * { -webkit-tap-highlight-color: transparent; }
    .opcion-activa { border-color: #f97316 !important; background: rgba(249,115,22,.10) !important; box-shadow: 0 0 0 1px rgba(249,115,22,.25); }
    .hora-activa { background: #ea580c !important; border-color: #f97316 !important; color: #fff !important; }
  </style>
</head>
<body class="min-h-screen font-sans">

  <main class="w-full max-w-3xl mx-auto pb-12">

    <!-- HERO DE LA SUCURSAL -->
    <section class="relative bg-zinc-950 border-b border-zinc-900">
      <% if (sucursal.foto_url) { %>
        <div class="h-56 md:h-72 overflow-hidden">
          <img src="<%= sucursal.foto_url %>" alt="<%= sucursal.nombre %>" class="w-full h-full object-cover opacity-70">
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/30 to-black/20"></div>
      <% } else { %>
        <div class="h-44 bg-gradient-to-br from-zinc-900 to-black"></div>
      <% } %>

      <div class="relative px-4 md:px-6 -mt-16 pb-6">
        <div class="flex items-end gap-4">
          <div class="w-24 h-24 md:w-28 md:h-28 rounded-2xl overflow-hidden border-4 border-zinc-950 bg-zinc-900 shadow-2xl shrink-0 flex items-center justify-center">
            <% if (sucursal.logo_url) { %>
              <img src="<%= sucursal.logo_url %>" alt="Logo" class="w-full h-full object-contain bg-white">
            <% } else { %>
              <i class="fas fa-scissors text-3xl text-orange-500"></i>
            <% } %>
          </div>

          <div class="pb-1 min-w-0">
            <p class="text-orange-500 text-xs font-black uppercase tracking-[.2em]">Reservas online</p>
            <h1 class="text-2xl md:text-4xl font-black text-white truncate"><%= sucursal.nombre %></h1>
            <% if (sucursal.direccion) { %>
              <p class="text-zinc-400 text-sm mt-1">
                <i class="fas fa-location-dot text-orange-500 mr-1"></i>
                <%= sucursal.direccion %>
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <div class="px-4 md:px-6 pt-5 space-y-5">

      <% if (reservaOk) { %>
        <section class="bg-green-500/10 border border-green-500/30 rounded-2xl p-5">
          <div class="flex gap-3">
            <div class="w-11 h-11 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center shrink-0">
              <i class="fas fa-check"></i>
            </div>
            <div>
              <h2 class="text-white font-black text-lg">¡Turno reservado!</h2>
              <p class="text-zinc-300 text-sm mt-1">La reserva quedó registrada correctamente en <%= sucursal.nombre %>.</p>
              <% if (turnoId) { %>
                <p class="text-green-400 text-xs font-bold mt-2">Reserva #<%= turnoId %></p>
              <% } %>
            </div>
          </div>
        </section>
      <% } %>

      <% if (error) { %>
        <section class="bg-red-500/10 border border-red-500/30 rounded-2xl p-4 text-sm text-red-300">
          <i class="fas fa-triangle-exclamation mr-2"></i><%= error %>
        </section>
      <% } %>

      <!-- HORARIOS DE ATENCIÓN -->
      <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div>
            <p class="text-[10px] uppercase tracking-[.2em] text-zinc-500 font-black">Sucursal</p>
            <h2 class="text-white font-black text-lg mt-1">Horarios de atención</h2>
          </div>
          <i class="far fa-clock text-orange-500 text-xl"></i>
        </div>

        <% if (!horarios || horarios.length === 0) { %>
          <p class="text-zinc-500 text-sm">Todavía no hay horarios publicados.</p>
        <% } else { %>
          <% const agrupados = {}; %>
          <% horarios.forEach(h => { %>
            <% if (!agrupados[h.barbero_nombre]) agrupados[h.barbero_nombre] = {}; %>
            <% if (!agrupados[h.barbero_nombre][h.dia]) agrupados[h.barbero_nombre][h.dia] = []; %>
            <% agrupados[h.barbero_nombre][h.dia].push(`${String(h.hora_inicio).substring(0,5)} a ${String(h.hora_fin).substring(0,5)}`); %>
          <% }); %>

          <div class="space-y-4">
            <% Object.keys(agrupados).forEach(nombre => { %>
              <div class="border-t border-zinc-800 first:border-t-0 first:pt-0 pt-4">
                <p class="font-bold text-orange-400 mb-2"><%= nombre %></p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <% Object.keys(agrupados[nombre]).forEach(dia => { %>
                    <div class="flex justify-between gap-3 text-xs bg-black/30 rounded-xl px-3 py-2">
                      <span class="text-zinc-400 font-bold"><%= dia %></span>
                      <span class="text-zinc-200 text-right"><%= agrupados[nombre][dia].join(' · ') %></span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>

      <form id="formReserva" action="/b/<%= sucursal.id %>/reservar" method="POST" class="space-y-5">

        <!-- PASO 1 SERVICIO -->
        <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
          <div class="flex gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-orange-600 text-white font-black flex items-center justify-center shrink-0">1</span>
            <div>
              <h2 class="text-white font-black text-lg">Elegí un servicio</h2>
              <p class="text-zinc-500 text-xs mt-1">Seleccioná qué querés realizarte.</p>
            </div>
          </div>

          <% if (!servicios || servicios.length === 0) { %>
            <p class="text-zinc-500 text-sm">Esta sucursal todavía no tiene servicios cargados.</p>
          <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% servicios.forEach(servicio => { %>
                <button type="button"
                  class="servicio-card text-left bg-black/30 border border-zinc-800 rounded-xl p-4 hover:border-zinc-700 transition"
                  data-id="<%= servicio.id %>">
                  <p class="text-white font-black"><%= servicio.nombre %></p>
                  <div class="flex items-center justify-between gap-3 mt-2">
                    <span class="text-orange-400 font-black">$<%= Number(servicio.precio || 0).toLocaleString('es-AR') %></span>
                    <span class="text-zinc-500 text-xs"><i class="far fa-clock mr-1"></i><%= servicio.duracion_minutos || 30 %> min</span>
                  </div>
                </button>
              <% }); %>
            </div>
          <% } %>

          <input type="hidden" name="servicio_id" id="servicio_id" required>
        </section>

        <!-- PASO 2 PROFESIONAL -->
        <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
          <div class="flex gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-orange-600 text-white font-black flex items-center justify-center shrink-0">2</span>
            <div>
              <h2 class="text-white font-black text-lg">Elegí tu profesional</h2>
              <p class="text-zinc-500 text-xs mt-1">Los profesionales que ves pertenecen únicamente a esta sucursal.</p>
            </div>
          </div>

          <% if (!barberos || barberos.length === 0) { %>
            <p class="text-zinc-500 text-sm">Esta sucursal todavía no tiene profesionales cargados.</p>
          <% } else { %>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <% barberos.forEach(barbero => { %>
                <button type="button"
                  class="barbero-card bg-black/30 border border-zinc-800 rounded-xl p-3 text-center hover:border-zinc-700 transition"
                  data-id="<%= barbero.id %>">
                  <div class="w-16 h-16 rounded-full overflow-hidden mx-auto bg-zinc-800 flex items-center justify-center">
                    <% if (barbero.foto_url) { %>
                      <img src="<%= barbero.foto_url %>" alt="<%= barbero.nombre %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <i class="fas fa-user text-zinc-600 text-xl"></i>
                    <% } %>
                  </div>
                  <p class="text-white font-bold text-sm mt-2 truncate"><%= barbero.nombre %></p>
                </button>
              <% }); %>
            </div>
          <% } %>

          <input type="hidden" name="barbero_id" id="barbero_id" required>
        </section>

        <!-- PASO 3 FECHA Y HORA -->
        <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
          <div class="flex gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-orange-600 text-white font-black flex items-center justify-center shrink-0">3</span>
            <div>
              <h2 class="text-white font-black text-lg">Elegí día y horario</h2>
              <p class="text-zinc-500 text-xs mt-1">Solo mostramos horarios realmente disponibles.</p>
            </div>
          </div>

          <label class="block text-xs font-bold text-zinc-400 mb-2" for="fecha">Fecha</label>
          <input type="date" id="fecha" name="fecha" min="<%= hoy %>" max="<%= fechaMaxima %>" required
            class="w-full bg-black/40 border border-zinc-800 rounded-xl px-4 py-3 text-white outline-none focus:border-orange-500">

          <div class="mt-4">
            <p class="text-xs font-bold text-zinc-400 mb-2">Horarios libres</p>
            <div id="estadoHorarios" class="text-sm text-zinc-500 bg-black/20 rounded-xl p-4">
              Elegí primero servicio, profesional y fecha.
            </div>
            <div id="listaHorarios" class="hidden grid grid-cols-3 sm:grid-cols-5 gap-2"></div>
          </div>

          <input type="hidden" name="hora" id="hora" required>
        </section>

        <!-- PASO 4 DATOS -->
        <section class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
          <div class="flex gap-3 mb-4">
            <span class="w-8 h-8 rounded-full bg-orange-600 text-white font-black flex items-center justify-center shrink-0">4</span>
            <div>
              <h2 class="text-white font-black text-lg">Tus datos</h2>
              <p class="text-zinc-500 text-xs mt-1">Los usamos para identificar tu reserva.</p>
            </div>
          </div>

          <div class="space-y-3">
            <div>
              <label class="block text-xs font-bold text-zinc-400 mb-2">Nombre y apellido</label>
              <input type="text" name="cliente_nombre" required maxlength="100" autocomplete="name"
                class="w-full bg-black/40 border border-zinc-800 rounded-xl px-4 py-3 text-white outline-none focus:border-orange-500"
                placeholder="Ej: Juan Pérez">
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-400 mb-2">WhatsApp</label>
              <input type="tel" name="cliente_whatsapp" required maxlength="30" inputmode="tel" autocomplete="tel"
                class="w-full bg-black/40 border border-zinc-800 rounded-xl px-4 py-3 text-white outline-none focus:border-orange-500"
                placeholder="Ej: 3515551234">
            </div>
          </div>
        </section>

        <button type="submit" id="btnReservar"
          class="w-full bg-orange-600 hover:bg-orange-500 text-white font-black py-4 rounded-2xl transition shadow-lg shadow-orange-950/30 disabled:opacity-40 disabled:cursor-not-allowed">
          <i class="fas fa-calendar-check mr-2"></i>
          Confirmar turno
        </button>

        <p class="text-center text-[11px] text-zinc-600 leading-relaxed px-4">
          Al confirmar, ese horario deja de estar disponible para otras reservas.
        </p>
      </form>

      <footer class="pt-5 border-t border-zinc-900 text-center">
        <p class="text-[10px] text-zinc-600">Reservas gestionadas con BookBarber · MedinSur Dev</p>
      </footer>
    </div>
  </main>

<script>
  const sucursalId = '<%= sucursal.id %>';
  const servicioInput = document.getElementById('servicio_id');
  const barberoInput = document.getElementById('barbero_id');
  const fechaInput = document.getElementById('fecha');
  const horaInput = document.getElementById('hora');
  const listaHorarios = document.getElementById('listaHorarios');
  const estadoHorarios = document.getElementById('estadoHorarios');
  const formReserva = document.getElementById('formReserva');
  const btnReservar = document.getElementById('btnReservar');

  function seleccionarTarjeta(selector, tarjeta, input) {
    document.querySelectorAll(selector).forEach(el => el.classList.remove('opcion-activa'));
    tarjeta.classList.add('opcion-activa');
    input.value = tarjeta.dataset.id;
    horaInput.value = '';
    cargarDisponibilidad();
  }

  document.querySelectorAll('.servicio-card').forEach(card => {
    card.addEventListener('click', () => seleccionarTarjeta('.servicio-card', card, servicioInput));
  });

  document.querySelectorAll('.barbero-card').forEach(card => {
    card.addEventListener('click', () => seleccionarTarjeta('.barbero-card', card, barberoInput));
  });

  fechaInput.addEventListener('change', () => {
    horaInput.value = '';
    cargarDisponibilidad();
  });

  async function cargarDisponibilidad() {
    const servicioId = servicioInput.value;
    const barberoId = barberoInput.value;
    const fecha = fechaInput.value;

    listaHorarios.innerHTML = '';
    listaHorarios.classList.add('hidden');

    if (!servicioId || !barberoId || !fecha) {
      estadoHorarios.classList.remove('hidden');
      estadoHorarios.textContent = 'Elegí primero servicio, profesional y fecha.';
      return;
    }

    estadoHorarios.classList.remove('hidden');
    estadoHorarios.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Buscando horarios libres...';

    try {
      const params = new URLSearchParams({
        servicio_id: servicioId,
        barbero_id: barberoId,
        fecha
      });

      const response = await fetch(`/b/${sucursalId}/disponibilidad?${params.toString()}`);
      const data = await response.json();

      if (!response.ok || !data.ok) {
        estadoHorarios.textContent = data.mensaje || 'No pudimos consultar disponibilidad.';
        return;
      }

      if (!data.horarios || data.horarios.length === 0) {
        estadoHorarios.textContent = data.mensaje || 'No quedan horarios disponibles para ese día.';
        return;
      }

      estadoHorarios.classList.add('hidden');
      listaHorarios.classList.remove('hidden');

      data.horarios.forEach(horario => {
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = horario;
        boton.className = 'hora-btn bg-black/40 border border-zinc-800 text-zinc-200 font-bold py-3 rounded-xl hover:border-orange-500 transition';
        boton.addEventListener('click', () => {
          document.querySelectorAll('.hora-btn').forEach(el => el.classList.remove('hora-activa'));
          boton.classList.add('hora-activa');
          horaInput.value = horario;
        });
        listaHorarios.appendChild(boton);
      });
    } catch (error) {
      console.error(error);
      estadoHorarios.textContent = 'No pudimos consultar los horarios. Intentá nuevamente.';
    }
  }

  formReserva.addEventListener('submit', event => {
    if (!servicioInput.value || !barberoInput.value || !fechaInput.value || !horaInput.value) {
      event.preventDefault();
      alert('Seleccioná servicio, profesional, fecha y horario antes de confirmar.');
      return;
    }

    btnReservar.disabled = true;
    btnReservar.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Confirmando...';
  });
</script>

</body>
</html>

