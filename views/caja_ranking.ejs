<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Caja y Ranking - BookBarber</title>
  <style>
    /* Estilos Dark Mode alineados a BookBarber */
    body { font-family: 'Segoe UI', Roboto, sans-serif; background-color: #121212; color: #e0e0e0; margin: 0; padding: 15px; }
    .container { max-width: 800px; margin: 0 auto; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #2d2d2d; padding-bottom: 15px; }
    header h1 { font-size: 1.4rem; color: #ffffff; margin: 0; }
    .btn-back { background-color: #262626; color: #ff7a00; text-decoration: none; padding: 8px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: bold; border: 1px solid #ff7a00; }
    
    /* Filtros */
    .filtros-container { background: #1a1a1a; padding: 15px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #333; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; color: #aaa; font-size: 0.9rem; }
    .form-group select { width: 100%; padding: 10px; background: #2d2d2d; color: white; border: 1px solid #444; border-radius: 5px; font-size: 1rem; }
    
    /* Caja Total */
    .caja-card { background: linear-gradient(135deg, #ff7a00, #d35400); padding: 20px; border-radius: 10px; text-align: center; margin-bottom: 25px; box-shadow: 0 4px 10px rgba(255, 122, 0, 0.2); }
    .caja-title { font-size: 1.1rem; color: #fff; opacity: 0.9; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px; }
    .caja-monto { font-size: 2.5rem; font-weight: bold; color: #fff; margin: 0; }
    
    /* Ranking */
    .ranking-section h2 { font-size: 1.2rem; color: #fff; margin-bottom: 15px; border-bottom: 2px solid #ff7a00; padding-bottom: 5px; display: inline-block; }
    .ranking-item { background: #222; border-radius: 8px; padding: 15px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; border-left: 4px solid #444; }
    .ranking-item.top-1 { border-left-color: #f1c40f; } /* Dorado para el primero */
    .ranking-item.top-2 { border-left-color: #bdc3c7; } /* Plata */
    .ranking-item.top-3 { border-left-color: #cd7f32; } /* Bronce */
    
    .barbero-info { display: flex; flex-direction: column; gap: 3px; }
    .barbero-nombre { font-size: 1.1rem; font-weight: bold; color: #fff; }
    .barbero-servicios { font-size: 0.85rem; color: #aaa; }
    
    .barbero-recaudacion { font-size: 1.2rem; font-weight: bold; color: #2ecc71; }
    
    .empty-state { text-align: center; color: #777; padding: 20px; font-style: italic; }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>📊 Caja y Ranking</h1>
    <a href="/dashboard" class="btn-back">← Dashboard</a>
  </header>

  <div class="filtros-container">
    <div class="form-group">
      <label for="filtro-sucursal">🏢 Seleccionar Barbería:</label>
      <select id="filtro-sucursal" onchange="calcularEstadisticas()">
        <option value="todas">Todas las sucursales</option>
        <% sucursales.forEach(suc => { %>
          <option value="<%= suc %>"><%= suc %></option>
        <% }) %>
      </select>
    </div>
    
    <div class="form-group" style="margin-bottom: 0;">
      <label for="filtro-tiempo">⏱️ Período de tiempo:</label>
      <select id="filtro-tiempo" onchange="calcularEstadisticas()">
        <option value="hoy">Hoy</option>
        <option value="semana">Esta Semana</option>
        <option value="mes">Este Mes</option>
        <option value="ano">Este Año</option>
      </select>
    </div>
  </div>

  <div class="caja-card">
    <div class="caja-title">Ingresos Totales</div>
    <div class="caja-monto" id="caja-total">$0</div>
  </div>

  <div class="ranking-section">
    <h2>🏆 Ranking de Barberos</h2>
    <div id="ranking-contenedor">
      </div>
  </div>

</div>

<script>
  const turnosData = <%- JSON.stringify(turnosFacturados) %>;
  
  // Formateador de moneda (Pesos)
  const formatMoney = (amount) => {
    return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(amount);
  };

  // Función para saber si una fecha cae en el filtro seleccionado
  function perteneceAlFiltro(fechaTurno, filtro) {
    const fecha = new Date(fechaTurno);
    const hoy = new Date();
    
    // Normalizamos horas para comparar solo días
    fecha.setHours(0,0,0,0);
    const fechaHoy = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());

    if (filtro === 'hoy') {
      return fecha.getTime() === fechaHoy.getTime();
    } 
    else if (filtro === 'semana') {
      // Lógica simple para últimos 7 días (o podes ajustarlo a Lunes-Domingo actual)
      const haceUnaSemana = new Date(fechaHoy);
      haceUnaSemana.setDate(haceUnaSemana.getDate() - 7);
      return fecha >= haceUnaSemana && fecha <= fechaHoy;
    } 
    else if (filtro === 'mes') {
      return fecha.getMonth() === hoy.getMonth() && fecha.getFullYear() === hoy.getFullYear();
    } 
    else if (filtro === 'ano') {
      return fecha.getFullYear() === hoy.getFullYear();
    }
    return true;
  }

  function calcularEstadisticas() {
    const sucursalSel = document.getElementById('filtro-sucursal').value;
    const tiempoSel = document.getElementById('filtro-tiempo').value;

    let cajaTotal = 0;
    let estadisticasBarberos = {}; // { "Pedro": { servicios: 5, total: 15000 } }

    // Filtrar y calcular
    turnosData.forEach(turno => {
      // Validar Sucursal
      if (sucursalSel !== 'todas' && turno.sucursal_nombre !== sucursalSel) return;
      
      // Validar Tiempo
      if (!perteneceAlFiltro(turno.fecha, tiempoSel)) return;

      // Sumar a la caja total
      cajaTotal += Number(turno.precio);

      // Sumar al barbero individual
      if (!estadisticasBarberos[turno.barbero_nombre]) {
        estadisticasBarberos[turno.barbero_nombre] = { servicios: 0, recaudacion: 0 };
      }
      estadisticasBarberos[turno.barbero_nombre].servicios += 1;
      estadisticasBarberos[turno.barbero_nombre].recaudacion += Number(turno.precio);
    });

    // Actualizar UI: Caja
    document.getElementById('caja-total').innerText = formatMoney(cajaTotal);

    // Convertir objeto de barberos a Array para poder ordenarlo (Ranking)
    let rankingArray = Object.keys(estadisticasBarberos).map(nombre => {
      return {
        nombre: nombre,
        servicios: estadisticasBarberos[nombre].servicios,
        recaudacion: estadisticasBarberos[nombre].recaudacion
      };
    });

    // Ordenar de mayor a menor recaudación
    rankingArray.sort((a, b) => b.recaudacion - a.recaudacion);

    // Actualizar UI: Ranking
    const contenedor = document.getElementById('ranking-contenedor');
    contenedor.innerHTML = '';

    if (rankingArray.length === 0) {
      contenedor.innerHTML = '<div class="empty-state">No hay turnos completados para este filtro.</div>';
      return;
    }

    rankingArray.forEach((barbero, index) => {
      // Clases para colorear a los 3 primeros (Top 1, 2, 3)
      let topClass = index < 3 ? `top-${index + 1}` : '';
      let medalla = index === 0 ? '🥇 ' : index === 1 ? '🥈 ' : index === 2 ? '🥉 ' : `#${index + 1} `;

      const item = document.createElement('div');
      item.className = `ranking-item ${topClass}`;
      item.innerHTML = `
        <div class="barbero-info">
          <div class="barbero-nombre">${medalla}${barbero.nombre}</div>
          <div class="barbero-servicios">✂️ ${barbero.servicios} servicio(s) realizados</div>
        </div>
        <div class="barbero-recaudacion">${formatMoney(barbero.recaudacion)}</div>
      `;
      contenedor.appendChild(item);
    });
  }

  // Calcular inicialmente al cargar la página
  window.addEventListener('DOMContentLoaded', calcularEstadisticas);
</script>

</body>
</html>
